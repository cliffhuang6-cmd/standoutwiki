---
import Layout from '../layouts/Layout.astro';
import AdTopBanner from '../components/ads/AdTopBanner.astro';
import AdRectangle from '../components/ads/AdRectangle.astro';
import AdNative from '../components/ads/AdNative.astro';

---

<Layout
  title="Stand Out Sub-Abilities Guide – Hamon, Vampire & Fighting Styles | Stand Out Wiki"
  description="Master Sub-Abilities in Roblox STAND OUT. Compare Hamon (Jonathan, Caesar, Zeppeli) vs Vampire (Stone Mask). Learn movesets, synergies, and removal rules."
  canonicalPath="sub-abilities"
  breadcrumbs={[{ label: 'Sub-Abilities' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 text-xs font-bold mb-3 border border-indigo-200">
          <span>Combat Styles</span>
          <span>•</span>
          <span>Secondary Movesets</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          Stand Out Sub-Abilities Hub
        </h1>

        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          Sub-Abilities represent supplementary martial arts and supernatural disciplines in Roblox <strong>STAND OUT</strong>. Equipping a Sub-Ability gives you an extra row of active combat moves that execute alongside your primary Stand.
        </p>

        <AdTopBanner narrow={true} pageType="longSystemGuide" className="mt-6 mb-0" />
      </div>

      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <AdRectangle pageType="longSystemGuide" className="my-0" />
      </div>
    </div>

    <!-- The Two Core Disciplines -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Hamon Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm flex flex-col justify-between hover:border-amber-400 transition-all">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-900 flex items-center justify-center font-black text-2xl mb-4">
            ☀️
          </div>
          <span class="text-xs font-black uppercase tracking-wider text-amber-700">Solar Martial Art</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Hamon (The Ripple)</h2>
          <p class="text-xs text-slate-600 leading-relaxed mt-2.5">
            Sunlight breathing energy trained under master <strong>Lisa Lisa</strong>. Offers three distinct specializations: <strong>Jonathan Path</strong> (devastating physical overdrive), <strong>Caesar Path</strong> (bubble traps &amp; launchers), or <strong>Zeppeli Path</strong> (Zoom Punch &amp; life magnetism).
          </p>

          <div class="mt-5 space-y-2 text-xs text-slate-700">
            <div class="flex items-center gap-2 font-semibold">
              <span class="text-amber-500 font-bold">✓</span>
              <span>Bonus damage against undead mobs &amp; Vampires</span>
            </div>
            <div class="flex items-center gap-2 font-semibold">
              <span class="text-amber-500 font-bold">✓</span>
              <span>Life-Giving Overdrive accelerates gardening crops</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-100">
          <a
            href="/hamon/"
            class="block w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 text-center font-extrabold text-xs rounded-xl shadow-xs transition-colors"
          >
            Read Complete Hamon Walkthrough →
          </a>
        </div>
      </div>

      <!-- Vampire Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm flex flex-col justify-between hover:border-rose-400 transition-all">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-900 flex items-center justify-center font-black text-2xl mb-4">
            🩸
          </div>
          <span class="text-xs font-black uppercase tracking-wider text-rose-700">Undead Evolution</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Vampire (Stone Mask)</h2>
          <p class="text-xs text-slate-600 leading-relaxed mt-2.5">
            Awakened by activating the ancient <strong>Stone Mask</strong>. Unlocks rapid passive HP regeneration at night, contact freezing attacks, and long-range Space Ripper Stingy Eyes laser beams.
          </p>

          <div class="mt-5 space-y-2 text-xs text-slate-700">
            <div class="flex items-center gap-2 font-semibold">
              <span class="text-rose-500 font-bold">✓</span>
              <span>High health recovery that turns opponents into blood food</span>
            </div>
            <div class="flex items-center gap-2 font-semibold">
              <span class="text-rose-500 font-bold">✓</span>
              <span>Daylight vulnerability can be negated by the Shadow Cloak</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-100">
          <a
            href="/vampire/"
            class="block w-full py-3 bg-slate-900 hover:bg-slate-800 text-white text-center font-extrabold text-xs rounded-xl shadow-xs transition-colors"
          >
            Read Complete Vampire Walkthrough →
          </a>
        </div>
      </div>
    </div>

    <AdNative pageType="longSystemGuide" className="my-10" />

    <!-- Pluck Weapon Movesets & Update 1 Mechanics -->
    <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-100 text-purple-800 text-xs font-bold mb-3 border border-purple-200">
        <span>Update 1 Combat Expansion</span>
        <span>•</span>
        <span>Pluck Movesets</span>
      </div>
      <h2 class="text-2xl font-black text-slate-900">Pluck Weapon Movesets &amp; Universal Evasive</h2>
      <p class="text-xs text-slate-600 leading-relaxed mt-2">
        With the release of Update 1, both Jonathan Hamon and Vampire disciplines gain expanded synergy with the ancient <strong>Luck &amp; Pluck Sword</strong>. Wielding Pluck alters normal light attack strings and introduces devastating specialized sword arts:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6 text-xs text-slate-600 leading-relaxed">
        <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200">
          <h3 class="font-extrabold text-sm text-amber-900 mb-2">Jonathan Hamon: Sunlight Pluck Arts</h3>
          <ul class="space-y-2">
            <li><strong>Sunlight Slash:</strong> Charges blade with solar Ripple energy, sending a crescent arc projectile that breaks block posture.</li>
            <li><strong>Sword Overdrive:</strong> Pierces forward with holy sunlight flames, dealing bonus damage against Vampire bosses.</li>
            <li><strong>Parry Synergy:</strong> Parrying with Pluck equipped grants +5% bonus EX meter generation.</li>
          </ul>
        </div>

        <div class="p-5 rounded-2xl bg-rose-50/60 border border-rose-200">
          <h3 class="font-extrabold text-sm text-rose-900 mb-2">Vampire: Blood-Forged Pluck Arts</h3>
          <ul class="space-y-2">
            <li><strong>Corrupted Cleave:</strong> Sweeps in a wide 180° arc that inflicts bleeding damage over 4 seconds.</li>
            <li><strong>Vampiric Thrust:</strong> Lurches forward and drains 25% of damage dealt back as character health.</li>
            <li><strong>Shadow Resonance:</strong> When paired with the Shadow Cloak, reduces sword skill cooldowns by 15% in daylight.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- How to Reset Sub-Abilities -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 shadow-xl">
      <h2 class="text-xl font-black mb-4">How to Reset or Switch Sub-Abilities</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300 leading-relaxed">
        <div class="p-4 rounded-xl bg-slate-800 border border-slate-700">
          <h3 class="font-bold text-white text-sm mb-1">Method 1: Eat an Apple</h3>
          <p>
            Grow an Apple tree in your garden using seeds purchased from <strong>Big Chop</strong>. Eating a mature Apple safely clears your Sub-Ability without altering your Stand or level.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-slate-800 border border-slate-700">
          <h3 class="font-bold text-white text-sm mb-1">Method 2: Sapphire Rokakaka</h3>
          <p>
            Consuming a <strong>Sapphire Roka</strong> has a 50% chance to cleanse your Sub-Ability and grants 10% of your current level's EXP bar even if removal fails.
          </p>
        </div>
      </div>
    </div>

    <!-- Upcoming / Unconfirmed Sub-Abilities Watchlist -->
    <div class="mt-12 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold mb-3 border border-amber-200">
        <span>Trello &amp; Rumor Verification</span>
        <span>•</span>
        <span>Status as of Nov 26, 2026</span>
      </div>
      <h2 class="text-2xl font-black text-slate-900 mb-4">Upcoming &amp; Unconfirmed Sub-Abilities (Rock Human &amp; Cyborg)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-600 leading-relaxed">
        <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-extrabold text-sm text-slate-900">Rock Human (Part 8)</h3>
            <span class="px-2 py-0.5 rounded bg-amber-200 text-amber-900 font-bold text-[10px] uppercase">In Testing / Placeholder</span>
          </div>
          <p>
            Added to the official Trello under <em>"Unfinished / In Testing / Reworking"</em> on November 24, 2026 with a <strong>Part 8</strong> label. Currently an empty placeholder card with no published moveset, unlock quest, or release date. We will launch a dedicated guide once developer data is published.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-extrabold text-sm text-slate-900">Cyborg</h3>
            <span class="px-2 py-0.5 rounded bg-slate-200 text-slate-700 font-bold text-[10px] uppercase">Not Confirmed in STAND OUT</span>
          </div>
          <p>
            Despite frequent community searches, <strong>Cyborg does not exist on the official STAND OUT Trello or in any patch notes as of November 26, 2026</strong>. Players searching for Cyborg are often confusing STAND OUT with other Roblox JoJo titles (such as <em>Bizarre Lineage</em> or <em>YBA</em>).
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

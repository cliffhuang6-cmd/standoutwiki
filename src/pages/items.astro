---
import Layout from '../layouts/Layout.astro';
import { items } from '../data/items';

---

<Layout
  title="Stand Out Items & Crafting Recipes – Materials & Consumables | Stand Out Wiki"
  description="Complete items database for Roblox STAND OUT. View crafting recipes, consumable fruit effects, Steel Ingot farming locations, and Stand Chip drops."
  canonicalPath="items"
  breadcrumbs={[{ label: 'Items' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Item Encyclopedia</span>
        <span>•</span>
        <span>Materials &amp; Consumables</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Items &amp; Materials
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Browse the complete item catalog of Roblox <strong>STAND OUT</strong>. Find obtainment sources for crafting components like Steel Ingots and Arrow Parts, consumable fruits, and rare raid Stand Chips.
      </p>
    </div>

    <!-- Items Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 transition-all" id={item.slug}>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded bg-slate-100 text-slate-700">
                {item.category}
              </span>
            </div>

            <div class="flex items-center gap-4 mb-4">
              <div class="w-14 h-14 rounded-xl bg-slate-50 border border-slate-200 p-2 flex items-center justify-center shrink-0">
                <img
                  src={item.image || '/images/items/apple.webp'}
                  alt={item.name}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              </div>
              <div>
                <h2 class="text-base font-black text-slate-900">{item.name}</h2>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">{item.obtainMethod}</p>
              </div>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {item.description}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 text-xs text-slate-600">
            <span class="font-bold text-slate-800 block mb-1">Key Uses:</span>
            <ul class="space-y-1">
              {item.uses.map((u) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-emerald-500 font-bold">•</span>
                  <span>{u}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ImageModal from '../components/ImageModal';
import { items } from '../data/items';

const categorySections = [
  {
    id: 'arrow',
    name: 'Summon Arrows & Focus Arrows',
    category: 'Arrow',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    description: 'Mysterious, Lucky, Bizarre, and Part-specific focus arrows used to summon Stands from the meteor.',
  },
  {
    id: 'consumable',
    name: 'Consumables & Combat Food',
    category: 'Consumable',
    badgeClass: 'bg-purple-50 text-purple-800 border-purple-200',
    description: 'Food, beverages, and recovery items providing health restoration and passive combat buffs.',
  },
  {
    id: 'material',
    name: 'Crafting Materials & Minerals',
    category: 'Material',
    badgeClass: 'bg-blue-50 text-blue-800 border-blue-200',
    description: 'Forging ores, refined ingots, and botanical ingredients required for equipment and crafting recipes.',
  },
  {
    id: 'story',
    name: 'Story Relics & NPC Artifacts',
    category: 'Story',
    badgeClass: 'bg-amber-50 text-amber-800 border-amber-200',
    description: 'Key items, municipal documents, and progression artifacts required to unlock Honolulu quests.',
  },
  {
    id: 'stand-chip',
    name: 'Stand Storage Chips',
    category: 'Stand Chip',
    badgeClass: 'bg-rose-50 text-rose-800 border-rose-200',
    description: "Memory chips utilized by D'Arby in the casino cellar to safely store and switch Stand slots.",
  },
];

---

<Layout
  title="Stand Out Items & Crafting Recipes – Materials, Consumables & Arrows | Stand Out Wiki"
  description={`Complete ${items.length}-item database for Roblox STAND OUT. View high-resolution item graphics, crafting bench formulas, consumable fruit effects, Steel Ingot locations, and Stand Chip storage.`}
  canonicalPath="items"
  breadcrumbs={[{ label: 'Items' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase tracking-wider mb-3 border border-emerald-200">
        <span>Verified Item Encyclopedia</span>
        <span>•</span>
        <span>{items.length} Tracked Game Items</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Stand Out Items &amp; Materials
      </h1>

      <p class="mt-4 text-base text-slate-600 leading-relaxed font-medium">
        Browse the complete item catalog of Studio Umbra's <strong>STAND OUT</strong>. Click any item thumbnail to open an enlarged high-resolution image preview. Check obtainment sources for metallurgy materials, consumable recovery fruits, and rare raid Stand Chips.
      </p>
    </div>

    <!-- High-Demand Relics Quick Access Banner -->
    <div class="mb-10 p-5 rounded-2xl bg-amber-50/70 border border-amber-200">
      <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-amber-900 mb-2">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span>High-Demand Items &amp; Raid Relics</span>
      </div>
      <p class="text-xs text-amber-900/80 mb-3">
        Looking for specific endgame gear or evolution catalysts? Check our dedicated in-depth guides:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a
          href="/items/shadow-cloak/"
          class="p-3 rounded-xl bg-white border border-amber-200 hover:border-purple-400 hover:shadow-xs transition-all flex items-center justify-between"
        >
          <div>
            <div class="font-bold text-xs text-slate-900">Shadow Cloak</div>
            <div class="text-[11px] text-purple-700 font-medium">100% Vampire Sun Immunity</div>
          </div>
          <span class="text-xs text-slate-400">→</span>
        </a>
        <a
          href="/items/opal-rokakaka/"
          class="p-3 rounded-xl bg-white border border-amber-200 hover:border-emerald-400 hover:shadow-xs transition-all flex items-center justify-between"
        >
          <div>
            <div class="font-bold text-xs text-slate-900">Opal Rokakaka</div>
            <div class="text-[11px] text-emerald-700 font-medium">SPTW / TWAU Catalyst</div>
          </div>
          <span class="text-xs text-slate-400">→</span>
        </a>
        <a
          href="/items/pluck/"
          class="p-3 rounded-xl bg-white border border-amber-200 hover:border-amber-400 hover:shadow-xs transition-all flex items-center justify-between"
        >
          <div>
            <div class="font-bold text-xs text-slate-900">Pluck Sword</div>
            <div class="text-[11px] text-amber-700 font-medium">77 Rings Raid Relic</div>
          </div>
          <span class="text-xs text-slate-400">→</span>
        </a>
      </div>
    </div>

    <!-- Category Quick Jump Navigation -->
    <div class="flex flex-wrap items-center gap-2 mb-10 pb-6 border-b border-slate-200 text-xs font-bold sticky top-16 bg-[#FFFDF3]/95 backdrop-blur-sm z-10 py-3">
      <span class="text-slate-400 uppercase tracking-wider text-[11px] mr-2">Quick Jump:</span>
      {categorySections.map((sec) => (
        <a
          href={`#${sec.id}`}
          class={`px-3 py-1.5 rounded-lg border font-bold transition-colors ${sec.badgeClass} hover:opacity-80`}
        >
          {sec.name.split('&')[0].trim()} ({items.filter(i => i.category === sec.category).length})
        </a>
      ))}
    </div>

    <!-- Grouped Categories -->
    <div class="space-y-14">
      {categorySections.map((sec) => {
        const categoryItems = items.filter((item) => item.category === sec.category);
        return (
          <section id={sec.id} class="scroll-mt-24">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-3 mb-6 border-b border-slate-200">
              <div class="flex items-center gap-3">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                  {sec.name}
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                  {categoryItems.length} {categoryItems.length === 1 ? 'item' : 'items'}
                </span>
              </div>
              <p class="text-xs text-slate-500 font-medium">
                {sec.description}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {categoryItems.map((item) => (
                <div
                  class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:border-emerald-400 hover:shadow-md transition-all group flex flex-col"
                  id={item.slug}
                >
                  {/* Card Header & Category Badge */}
                  <div class="flex items-center justify-between mb-3">
                    <span class="px-2.5 py-1 text-[11px] font-black uppercase tracking-wider rounded-lg bg-slate-100 text-slate-700 border border-slate-200">
                      {item.category}
                    </span>
                    {item.sellPrice && (
                      <span class="text-xs font-mono font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                        {item.sellPrice.startsWith('$') ? `Est. Value: ${item.sellPrice}` : item.sellPrice}
                      </span>
                    )}
                  </div>

                  {/* Clean Image Container (h-28 to h-32 centered) */}
                  <div class="w-full h-28 sm:h-32 bg-slate-50 rounded-xl border border-slate-200/80 p-2 mb-3.5 flex items-center justify-center overflow-hidden">
                    <ImageModal
                      client:load
                      src={item.image || '/images/items/apple.webp'}
                      alt={item.name}
                      title={item.name}
                      subtitle={`Category: ${item.category} • ${item.sellPrice ? (item.sellPrice.startsWith('$') ? 'Est. Value: ' + item.sellPrice : item.sellPrice) : 'Non-Tradeable'}`}
                      className="w-full h-full flex items-center justify-center"
                    />
                  </div>

                  {/* Title & Obtainment */}
                  <h3 class="text-base font-black text-slate-900 group-hover:text-emerald-800 transition-colors">
                    <a href={`/items/${item.slug}/`} class="hover:underline flex items-center justify-between">
                      <span>{item.name}</span>
                      <span class="text-xs text-emerald-600 font-bold">&rarr;</span>
                    </a>
                  </h3>

                  <div class="mt-1.5 mb-3 p-2 bg-slate-50 rounded-lg border border-slate-100 text-xs text-slate-600">
                    <span class="font-bold text-slate-800 block text-[10px] uppercase tracking-wider mb-0.5">
                      📍 Obtainment:
                    </span>
                    <p class="leading-relaxed">{item.obtainMethod}</p>
                  </div>

                  {/* Description */}
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                    {item.description}
                  </p>

                  {/* Key Uses */}
                  {item.uses && item.uses.length > 0 && (
                    <div class="mt-auto pt-3 border-t border-slate-100 text-xs text-slate-600">
                      <span class="font-bold text-slate-800 uppercase tracking-wider text-[10px] block mb-1.5">
                        Primary Utilities &amp; Uses:
                      </span>
                      <ul class="space-y-1">
                        {item.uses.map((use) => (
                          <li class="flex items-start gap-1.5">
                            <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                            <span class="leading-relaxed">{use}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

  </div>
</Layout>

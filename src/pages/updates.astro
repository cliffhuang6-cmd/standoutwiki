---
import Layout from '../layouts/Layout.astro';
import { updateLogs } from '../data/updates';

---

<Layout
  title="Stand Out Updates & Changelog – Latest Roblox Patch Notes | Stand Out Wiki"
  description="Chronological update timeline and balance patch notes for Roblox STAND OUT. Track newly released Stands, arrow crafting changes, and bug fixes from Studio Umbra."
  canonicalPath="updates"
  breadcrumbs={[{ label: 'Updates & Changelog' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Studio Umbra Changelog</span>
        <span>•</span>
        <span>Version History</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Patch Notes &amp; Updates
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Stay up to date with every patch, balance pass, and content addition pushed by Studio Umbra: Europa for Roblox <strong>STAND OUT</strong>. Verified directly against official release announcements.
      </p>
    </div>

    <!-- Timeline of Updates -->
    <div class="space-y-8">
      {updateLogs.map((log) => (
        <article class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-100 mb-4">
            <div>
              <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md">
                📅 {log.date}
              </span>
              <h2 class="text-xl font-black text-slate-900 mt-2">{log.title}</h2>
            </div>
          </div>

          <p class="text-xs text-slate-600 leading-relaxed mb-4 font-medium">
            {log.summary}
          </p>

          <div class="space-y-4 pt-2">
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Content &amp; Balance Adjustments:
              </h3>
              <ul class="space-y-1.5 text-xs text-slate-600">
                {log.changes.map((ch) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 font-bold">✦</span>
                    <span>{ch}</span>
                  </li>
                ))}
              </ul>
            </div>

            {log.bugFixes && log.bugFixes.length > 0 && (
              <div class="pt-2">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                  Bug Fixes:
                </h3>
                <ul class="space-y-1 text-xs text-slate-500">
                  {log.bugFixes.map((bf) => (
                    <li class="flex items-start gap-2">
                      <span class="text-slate-400">✓</span>
                      <span>{bf}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>

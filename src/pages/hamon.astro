---
import Layout from '../layouts/Layout.astro';
import AdTopBanner from '../components/ads/AdTopBanner.astro';
import AdSidebar from '../components/ads/AdSidebar.astro';
import AdNative from '../components/ads/AdNative.astro';

---

<Layout
  title="How to Get Hamon in Stand Out – Lisa Lisa Quest & Paths Guide | Stand Out Wiki"
  description="Complete Hamon guide for Roblox STAND OUT. Learn how to complete Lisa Lisa's 300-breath mask quest and compare Jonathan, Caesar, and Zeppeli discipline paths."
  canonicalPath="hamon"
  breadcrumbs={[
    { label: 'Sub-Abilities', href: '/sub-abilities/' },
    { label: 'Hamon Guide' }
  ]}
  schemaType="Article"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-9 min-w-0">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold mb-3 border border-amber-200">
        <span>Sub-Ability Walkthrough</span>
        <span>•</span>
        <span>Solar Ripple Energy</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        How to Get Hamon in Stand Out: Complete Guide
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        <strong>Hamon (The Ripple)</strong> is one of the most versatile martial fighting styles in Roblox <strong>STAND OUT</strong>. Providing bonus damage against undead enemies, health regeneration, and special Overdrive moves, Hamon can elevate both beginner and endgame Stand builds.
      </p>
    </div>

    <AdTopBanner narrow={true} pageType="narrowGuide" className="mb-8 mt-0" />

    <!-- Step-by-Step Acquisition -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6 mb-12">
      <h2 class="text-2xl font-black text-slate-900">Step-by-Step: Unlocking Hamon</h2>

      <div class="space-y-6 text-xs text-slate-600 leading-relaxed">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-slate-950 font-black flex items-center justify-center shrink-0">1</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Locate Master Lisa Lisa</h3>
            <p class="mt-1">
              Travel to the Venice canals and find <strong>Lisa Lisa</strong> standing near the stone bridge entrance. You must be at least Level 15 and have an empty Sub-Ability slot.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-slate-950 font-black flex items-center justify-center shrink-0">2</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Purchase &amp; Equip the Ripple Mask</h3>
            <p class="mt-1">
              Purchase the <strong>Ripple Training Mask</strong> accessory from Lisa Lisa for 1,500 Dalas. Open your inventory and equip the mask on your character.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-slate-950 font-black flex items-center justify-center shrink-0">3</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Complete 300 Controlled Breaths</h3>
            <p class="mt-1">
              Use your breath charging hotkey while wearing the mask. Each full inhale registers 1 count. Complete <strong>300 breathing cycles (0/300)</strong> to master lung capacity.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-slate-950 font-black flex items-center justify-center shrink-0">4</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Select Your Hamon Discipline Path</h3>
            <p class="mt-1">
              Return to Lisa Lisa to claim your Hamon awakening and select your specialization path.
            </p>
          </div>
        </div>
      </div>
    </div>

    <AdNative pageType="narrowGuide" className="my-8" />

    <!-- The 3 Hamon Paths -->
    <section class="space-y-6 mb-12">
      <h2 class="text-2xl font-black text-slate-900">The Three Hamon Paths Compared</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Jonathan Path -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <span class="text-[10px] font-black uppercase text-amber-700 block mb-1">Direct Physical Combat</span>
          <h3 class="text-lg font-black text-slate-900">Jonathan Path</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Focused on raw physical overdrive strikes and life energy healing.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-700">
            <li><strong>Sunlight Yellow Overdrive:</strong> Rapid golden strike barrage.</li>
            <li><strong>Overdrive Beatdown:</strong> High-damage knockback finisher.</li>
            <li><strong>Healing Breath:</strong> Channel ripple to restore 25% max HP.</li>
          </ul>
        </div>

        <!-- Caesar Path -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <span class="text-[10px] font-black uppercase text-amber-700 block mb-1">Projectile &amp; Traps</span>
          <h3 class="text-lg font-black text-slate-900">Caesar Path</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Emphasizes zoning bubbles, refraction lenses, and crowd control barriers.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-700">
            <li><strong>Bubble Launcher:</strong> High-speed tracking bubble spheres.</li>
            <li><strong>Bubble Cutter:</strong> Spinning razor-sharp projectile discs.</li>
            <li><strong>Bubble Barrier:</strong> Encases target in a floating bubble trap.</li>
          </ul>
        </div>

        <!-- Zeppeli Path -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <span class="text-[10px] font-black uppercase text-amber-700 block mb-1">Mobility &amp; Spacing</span>
          <h3 class="text-lg font-black text-slate-900">Zeppeli Path</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Tactical disengagement, joint elongation, and environmental conduction.
          </p>
          <ul class="mt-4 space-y-1.5 text-xs text-slate-700">
            <li><strong>Zoom Punch:</strong> Dislocates arm joints for extreme reach.</li>
            <li><strong>Life Magnetism:</strong> Clings to walls and pulls objects.</li>
            <li><strong>Torquoise Overdrive:</strong> Aquatic shockwave wave.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Pluck Sword Synergy Card -->
    <div class="p-6 rounded-2xl bg-amber-50/70 border border-amber-200 mb-12 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-amber-800">Martial Weapon Synergy</span>
        <h3 class="text-base font-black text-slate-900 mt-0.5">Wield the Pluck Sword with Hamon</h3>
        <p class="text-xs text-slate-600 mt-0.5">Pluck possesses natural Hamon conductivity, granting -25% stamina cost and +6s Sunlight Overdrive infusion duration.</p>
      </div>
      <a href="/items/pluck/" class="px-4 py-2 rounded-xl bg-amber-600 text-white font-bold text-xs hover:bg-amber-700 transition-colors shrink-0">
        Pluck Sword Guide &rarr;
      </a>
    </div>

    <!-- Related Walkthrough Banner -->
    <div class="p-5 rounded-2xl bg-slate-100 border border-slate-200 mb-12 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-xs font-black uppercase tracking-wider text-slate-700">Step-by-Step Walkthrough</span>
        <h3 class="text-base font-black text-slate-900 mt-0.5">Need help completing Lisa Lisa's 300 Breaths?</h3>
        <p class="text-xs text-slate-600 mt-0.5">Read our full quest walkthrough with Venice canal map markers, breath rhythm timing, and mask tips.</p>
      </div>
      <a href="/guides/hamon/" class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition-colors shrink-0">
        Read Quest Guide &rarr;
      </a>
    </div>

    <!-- Resetting Hamon -->
    <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6 text-xs text-slate-600">
      <h3 class="font-bold text-sm text-slate-900 mb-2">Want to Switch Paths or Reset Hamon?</h3>
      <p>
        If you wish to switch from Jonathan to Caesar or become a Vampire instead, simply eat a mature <strong>Apple</strong> (cultivated from seeds at Big Chop) or consume a <strong>Sapphire Rokakaka</strong> fruit. Your Stand and character level will remain completely intact.
      </p>
    </div>
      </div>

      <aside class="lg:col-span-3 flex flex-col items-center lg:items-end space-y-6">
        <AdSidebar size="160x300" pageType="narrowGuide" sticky={true} className="my-0" />
      </aside>
    </div>
  </div>
</Layout>

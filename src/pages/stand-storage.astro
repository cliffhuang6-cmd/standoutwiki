---
import Layout from '../layouts/Layout.astro';
import AdTopBanner from '../components/ads/AdTopBanner.astro';
import AdSidebar from '../components/ads/AdSidebar.astro';
import AdNative from '../components/ads/AdNative.astro';

---

<Layout
  title="Stand Out Stand Storage – D'Arby Chips & Character Slots Guide | Stand Out Wiki"
  description="Learn how to store and swap Stands safely in Roblox STAND OUT. Complete guide to D'Arby Stand Chips, slot management, and unlocking extra character slots."
  canonicalPath="stand-storage"
  breadcrumbs={[{ label: 'Stand Storage' }]}
  schemaType="Article"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-9 min-w-0">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Account Progression</span>
        <span>•</span>
        <span>Safe Stand Banking</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Stand Storage &amp; Slots Guide
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Rolling a rare Pinnacle Stand like Star Platinum or King Crimson is an exciting milestone, but what if you want to test other Stands without losing your prize? Learn how to use <strong>D'Arby Stand Storage</strong> and unlock all 3 character slots.
      </p>
    </div>

    <AdTopBanner narrow={true} pageType="narrowGuide" className="mb-8 mt-0" />

    <!-- D'Arby Storage Walkthrough -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6 mb-12">
      <h2 class="text-2xl font-black text-slate-900">How D'Arby's Stand Storage Works</h2>

      <div class="space-y-6 text-xs text-slate-600 leading-relaxed">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">1</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Visit D'Arby in the Town Casino</h3>
            <p class="mt-1">
              Locate <strong>D'Arby</strong> standing at the casino VIP chip counter. Speak to him to open your Stand Storage bank interface.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">2</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Deposit Stand into a Stand Chip</h3>
            <p class="mt-1">
              D'Arby extracts your current active Stand and compresses its soul data into a physical <strong>Stand Chip</strong> stored in your personal vault. Your character is left in Standless mode, ready for fresh arrow awakening.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center shrink-0">3</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Withdrawing a Stored Stand</h3>
            <p class="mt-1">
              To equip a stored Stand Chip, ensure your current Stand has been deposited or purged. Selecting the chip instantly restores the Stand with all its previous mastery intact.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Update 1 Free Stand Slot Notice -->
    <div class="bg-gradient-to-r from-emerald-500 to-teal-600 rounded-2xl p-6 text-white mb-10 shadow-sm flex items-center justify-between">
      <div>
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/20 text-xs font-black uppercase tracking-wider mb-2">Update 1 Feature</span>
        <h3 class="text-xl font-black">Bonus Free Stand Slot Granted to All Players</h3>
        <p class="text-xs text-white/90 mt-1 max-w-xl">
          To accommodate the 6 newly released Stands (Crazy Diamond, The Hand, Bad Company, The Lock, Cheap Trick, and Dolly Dagger), Studio Umbra gifted all active accounts an extra <strong>+1 Free Stand Slot</strong> in D'Arby's storage vault.
        </p>
      </div>
      <div class="hidden sm:block text-3xl font-black bg-white/10 rounded-xl px-4 py-2 text-center">
        +1 <span class="text-xs block font-bold uppercase text-white/80">Slot</span>
      </div>
    </div>

    <!-- Unlocking Character Slots -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6 mb-12">
      <h2 class="text-2xl font-black text-slate-900">Unlocking Additional Character Slots (Max 3)</h2>
      <p class="text-xs text-slate-600 leading-relaxed">
        Every player starts with 1 character profile slot. You can unlock up to <strong>3 independent character slots</strong>, allowing you to maintain different character builds (e.g. a pure Vampire build on Slot 1 and a Hamon SPTW build on Slot 2).
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <span class="font-black text-emerald-700 block mb-1">Requirement A</span>
          <p class="font-bold text-slate-900">Unlock 30 Unique Stands</p>
          <p class="text-slate-500 mt-1">Roll or awaken 30 different Stands across your lifetime catalog.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <span class="font-black text-emerald-700 block mb-1">Requirement B</span>
          <p class="font-bold text-slate-900">Complete Storyline Quest 10</p>
          <p class="text-slate-500 mt-1">Finish the entire main town storyline campaign.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
          <span class="font-black text-emerald-700 block mb-1">Requirement C</span>
          <p class="font-bold text-slate-900">100,000 Dalas (or Robux)</p>
          <p class="text-slate-500 mt-1">Pay the town registrar fee to permanently unlock the slot.</p>
        </div>
      </div>
    </div>

    <AdNative pageType="narrowGuide" className="my-8" />
      </div>

      <aside class="lg:col-span-3 flex flex-col items-center lg:items-end space-y-6">
        <AdSidebar size="160x300" pageType="narrowGuide" sticky={true} className="my-0" />
      </aside>
    </div>
  </div>
</Layout>

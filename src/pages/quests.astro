---
import Layout from '../layouts/Layout.astro';
import { quests } from '../data/quests';

const questCategories = [
  {
    id: 'storyline',
    name: 'Storyline Missions',
    category: 'Storyline',
    badgeClass: 'bg-blue-100 text-blue-800 border-blue-200',
    description: 'The core 10-chapter campaign spanning Honolulu underworld confrontations, Meryl Mei Qi delivery tasks, and Passione syndicate battles.',
  },
  {
    id: 'sub-ability',
    name: 'Sub-Ability Trials & Progression',
    category: 'Sub-Ability',
    badgeClass: 'bg-amber-100 text-amber-800 border-amber-200',
    description: 'Specialization questlines unlocking Hamon breathing mastery, Hermit Purple photographic spirit tracking, and the JoJosapiens research trial.',
  },
  {
    id: 'bounty',
    name: 'High-Value Bounty Targets',
    category: 'Bounty',
    badgeClass: 'bg-rose-100 text-rose-800 border-rose-200',
    description: 'Daily smartphone phone-in targets and rogue street bosses yielding massive Dalas bounties and tier rewards.',
  },
  {
    id: 'side-quest',
    name: 'Side Quests & Exploration',
    category: 'Side Quest',
    badgeClass: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    description: 'Local neighborhood errands, botanical seed requests, and scrap collection tasks providing useful baseline items.',
  },
];
---

<Layout
  title="Stand Out Quests & NPCs – Locations, Requirements & Rewards | Stand Out Wiki"
  description="Complete directory of all 17 quests and NPCs in Roblox STAND OUT. Objectives, locations, prerequisites, and rewards for Hamon, Hermit Purple, and Jojosapiens."
  canonicalPath="quests"
  breadcrumbs={[{ label: 'Quests & NPCs' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Town &amp; World Directory</span>
        <span>•</span>
        <span>{quests.length} Verified Encounters</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Quests &amp; NPC Directory
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed font-medium">
        From the 10 core Storyline progression missions and Sub-Ability masteries (Hamon &amp; Vampire) to high-yield Bounties and secret research unlocks, browse complete verified quest requirements and rewards below.
      </p>
    </div>

    <!-- Category Filter / Quick Jump Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-10 pb-6 border-b border-slate-200 text-xs font-bold sticky top-16 bg-[#FFFDF3]/95 backdrop-blur-sm z-10 py-3">
      <span class="text-slate-400 uppercase tracking-wider text-[11px] mr-2">Quick Jump:</span>
      <a
        href="#all"
        class="px-3 py-1.5 rounded-lg border font-bold transition-colors bg-emerald-600 text-white border-emerald-600 shadow-sm"
      >
        All Quests ({quests.length})
      </a>
      {questCategories.map((cat) => (
        <a
          href={`#${cat.id}`}
          class={`px-3 py-1.5 rounded-lg border font-bold transition-colors bg-white text-slate-700 border-slate-200 hover:border-emerald-300 hover:bg-slate-50`}
        >
          {cat.name.split(' ')[0]} ({quests.filter(q => q.category === cat.category).length})
        </a>
      ))}
    </div>

    <!-- Category Sections -->
    <div class="space-y-14" id="all">
      {questCategories.map((cat) => {
        const catQuests = quests.filter((q) => q.category === cat.category);
        return (
          <section id={cat.id} class="scroll-mt-24">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-3 mb-6 border-b border-slate-200">
              <div class="flex items-center gap-3">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                  {cat.name}
                </h2>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                  {catQuests.length} {catQuests.length === 1 ? 'quest' : 'quests'}
                </span>
              </div>
              <p class="text-xs text-slate-500 font-medium">
                {cat.description}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {catQuests.map((quest) => (
                <div
                  id={quest.slug}
                  class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 hover:shadow-md transition-all group"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class={`px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wider rounded ${cat.badgeClass}`}>
                        {quest.category}
                      </span>
                      <span class="text-xs font-semibold text-slate-500">
                        📍 {quest.location}
                      </span>
                    </div>

                    <h3 class="text-lg font-black text-slate-900 group-hover:text-emerald-700 transition-colors mt-1">
                      {quest.title}
                    </h3>
                    <p class="text-xs font-bold text-slate-600 mt-1">
                      Quest Giver: <span class="text-emerald-700">{quest.npc}</span>
                    </p>

                    {quest.prerequisites && (
                      <div class="mt-2.5 text-[11px] text-amber-900 bg-amber-50/80 p-2.5 rounded-xl border border-amber-200">
                        <span class="font-bold">Prerequisite:</span> {quest.prerequisites}
                      </div>
                    )}

                    <div class="mt-4 pt-3 border-t border-slate-100">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
                        Quest Objectives:
                      </span>
                      <ul class="space-y-2 text-xs text-slate-600">
                        {quest.objectives.map((obj) => (
                          <li class="flex items-start gap-2">
                            <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                            <span class="leading-relaxed">{obj}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="mt-5 pt-4 border-t border-slate-100 space-y-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block">
                      Guaranteed Rewards:
                    </span>
                    <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono font-bold">
                      {quest.rewards.exp && (
                        <span class="text-teal-700 bg-teal-50 px-2 py-0.5 rounded-lg border border-teal-200">
                          +{quest.rewards.exp.toLocaleString()} EXP
                        </span>
                      )}
                      {quest.rewards.dalas && (
                        <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200">
                          ${quest.rewards.dalas.toLocaleString()}
                        </span>
                      )}
                      {quest.rewards.stand && (
                        <span class="text-purple-700 bg-purple-50 px-2 py-0.5 rounded-lg border border-purple-200">
                          Stand: {quest.rewards.stand}
                        </span>
                      )}
                      {quest.rewards.items && quest.rewards.items.map((item) => (
                        <span class="text-amber-800 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200 text-[11px]">
                          🎁 {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Layout>

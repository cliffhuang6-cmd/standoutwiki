---
import Layout from '../layouts/Layout.astro';
import { quests } from '../data/quests';

---

<Layout
  title="Stand Out Quests & NPCs – Locations, Requirements & Rewards | Stand Out Wiki"
  description="Complete directory of quests and NPCs in Roblox STAND OUT. Objectives, locations, prerequisites, and rewards for Hamon, Hermit Purple, and Jojosapiens."
  canonicalPath="quests"
  breadcrumbs={[{ label: 'Quests & NPCs' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Town &amp; World Directory</span>
        <span>•</span>
        <span>Quests &amp; Encounters</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Quests &amp; NPC Directory
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        From unlocking fighting styles like Hamon with Lisa Lisa to acquiring exclusive quest Stands like Hermit Purple and Jojosapiens, browse full quest walkthroughs below.
      </p>
    </div>

    <!-- Quests List -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {quests.map((quest) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded bg-emerald-100 text-emerald-800">
                {quest.category}
              </span>
              <span class="text-xs font-semibold text-slate-500">
                📍 {quest.location}
              </span>
            </div>

            <h2 class="text-lg font-black text-slate-900 mt-1">{quest.title}</h2>
            <p class="text-xs font-bold text-slate-600 mt-1">
              Quest Giver: <span class="text-emerald-700">{quest.npc}</span>
            </p>

            {quest.prerequisites && (
              <div class="mt-2 text-[11px] text-amber-800 bg-amber-50 p-2 rounded-lg border border-amber-200">
                <strong>Prerequisite:</strong> {quest.prerequisites}
              </div>
            )}

            <div class="mt-4 pt-3 border-t border-slate-100">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 block mb-1.5">
                Objectives:
              </span>
              <ul class="space-y-1.5 text-xs text-slate-600">
                {quest.objectives.map((obj) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span>
                    <span>{obj}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-500">Rewards:</span>
            <div class="flex items-center gap-2 font-mono font-bold text-emerald-700">
              {quest.rewards.dalas && <span>{quest.rewards.dalas.toLocaleString()} Dalas</span>}
              {quest.rewards.stand && <span class="text-rose-600 font-bold bg-rose-50 px-1.5 py-0.5 rounded">{quest.rewards.stand}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ImageModal from '../components/ImageModal';
import AdTopBanner from '../components/ads/AdTopBanner.astro';
import AdRectangle from '../components/ads/AdRectangle.astro';
import AdNative from '../components/ads/AdNative.astro';

const supplies = [
  { name: 'Garden Pot', img: '/images/gardening/garden-pot.webp', source: 'Big Chop / Crafting Station (Wood + Steel)', role: 'Required container for each planted seed. Purchase extras from Big Chop to run multiple crops simultaneously.' },
  { name: 'Dirt Bag', img: '/images/gardening/dirt-bag.webp', source: 'Big Chop ($100 Dalas)', role: 'Must be poured into an empty Garden Pot before planting any seed (~2 uses per bag).' },
  { name: 'Ice Water', img: '/images/gardening/ice-water.webp', source: 'Big Chop ($50 Dalas)', role: 'Hydrates planted pots to prevent stalled growth ticks and maximize yield consistency.' },
  { name: 'Mysterious Fertilizer', img: '/images/gardening/mysterious-fertilizer.webp', source: 'Big Chop / FSA Defense / Crafting', role: 'Boosts crop grade quality (Critical for Perfect Emerald & S-Tier Opal Rokas) and speeds growth.' },
  { name: 'Empty Glass Jar', img: '/images/gardening/glass-jar.webp', source: 'Big Chop / Crafting Station', role: 'Packages harvested produce at the Packaging Station (+20% Nov 22 value boost up to +150% on Rokas).' },
];

const crops = [
  { name: 'Rokaka Seed / Fruit', img: '/images/rokakaka/rokakaka.webp', basePrice: '$1,200 (Jar $3,000)', growth: 'Slow (~18–25m base; 6m in 3x Greenhouse)', role: '3% mutation chance for 33 variants (Emerald, Sapphire, Opal, Amethyst). Sell at night to Big Chop.' },
  { name: 'Dragon Fruit', img: '/images/gardening/dragon-fruit.webp', basePrice: '$1,800+', growth: 'Slow / High-tier', role: 'Highest vendor resale fruit; package in Glass Jars for maximum Harbor Dalas profit.' },
  { name: 'Watermelon', img: '/images/gardening/watermelon.webp', basePrice: '$900', growth: 'Medium-Slow', role: 'Heavy hydrating fruit useful for heat mitigation and bulk Texts Garden Deliveries.' },
  { name: 'Apple', img: '/images/items/apple.webp', basePrice: '$600 (Jar $875)', growth: 'Medium', role: 'Solid stamina/health recovery and packaged delivery contracts.' },
  { name: 'Tomato', img: '/images/gardening/tomato.webp', basePrice: '$350', growth: 'Fast-Medium', role: 'Staple ingredient for town restaurant supply quests and fast Garden EXP.' },
  { name: 'Cherry', img: '/images/gardening/cherry.webp', basePrice: '$250', growth: 'Very Fast', role: 'Fastest seed turnaround for grinding Garden EXP and finishing Big Chop’s Daily Garden.' },
  { name: 'Lemon', img: '/images/gardening/lemon.webp', basePrice: 'Standard', growth: 'Medium', role: 'Brewable produce for status mixes and texts delivery haggling.' },
  { name: 'Banana', img: '/images/gardening/banana.webp', basePrice: 'Standard', growth: 'Fast-Medium', role: 'Consistent economy filler when expanding Garden Pot capacity.' },
  { name: 'Grapes', img: '/images/gardening/grapes.webp', basePrice: 'Standard', growth: 'Medium', role: 'Can be jarred or mixed into combat utility consumables.' },
  { name: 'Chili Pepper', img: '/images/gardening/chili-pepper.webp', basePrice: 'Standard', growth: 'Fast-Medium', role: 'Spicy crafting crop used in offensive mix recipes.' },
  { name: 'Peach', img: '/images/gardening/peach.webp', basePrice: 'Standard', growth: 'Medium', role: 'Balanced fruit yield for Texts delivery contracts and Mixing.' },
];

const featuredMutations = [
  { name: 'Emerald Roka', img: '/images/rokakaka/emerald-roka.webp', note: 'Removes your active Stand (60% / 85% / 100% by grade).' },
  { name: 'Sapphire Roka', img: '/images/rokakaka/sapphire-roka.webp', note: '50% chance to remove Hamon/Vampire + 10% EXP.' },
  { name: 'Opal Roka', img: '/images/rokakaka/opal-roka.webp', note: 'Evolves Star Platinum → SPTW or The World → TWAU.' },
  { name: 'Amethyst Roka', img: '/images/rokakaka/amethyst-roka.webp', note: 'Refills EX / Awakening meter & cleanses status.' },
];

const gardeningFaqs = [
  {
    q: 'Do plants and Rokakakas grow offline in STAND OUT?',
    a: 'No. Crops do not grow while you are completely offline. They only progress while you remain inside a live server: Public servers run at 1x base speed, Gang Bases run at 2x (3x specifically for Rokakakas inside Public servers), and Update 1 (Nov 22) buffed Private Servers from 0.25x to 0.5x growth speed.',
  },
  {
    q: 'How do you get more Garden Pots in STAND OUT?',
    a: 'Purchase additional Garden Pots directly from Big Chop at Big Chop’s Garden, or craft extra pots at the Crafting Station using Wood and Steel Ingots. Placing pots inside a shared Gang Base lets members manage pots together (Update 1 displays whose pot is whose and lets members remove empty pots).',
  },
  {
    q: 'How do you get Rokaka Seeds fast?',
    a: 'Buy seeds from Big Chop, complete Big Chop’s Daily Garden quest (place pot, fill dirt, plant, harvest for a random seed reward), harvest ripe fruit (Nov 15 patch raised seed-return probability per harvest by +5% and Nov 22 lets you keep harvesting even at the seed cap), or defend FSA raids (+1 Random Seed + 1 Mysterious Fertilizer).',
  },
  {
    q: 'How do you maximize crop mutation odds and selling prices?',
    a: 'Every harvested Rokakaka rolls a 3% base mutation chance. To farm faster: plant in a Public server Gang Base Rokakaka Growing Room (3x speed), align with the Fruit Company faction for extra crop/mutation bonuses, water during Rain (+20% speed), and package crops with Glass Jars (+20% Update 1 value boost) before selling via Texts deliveries (haggle for higher Dalas) or selling Rokas to Big Chop at night.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: gardeningFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Stand Out Gardening Guide – Seeds, Pots, Farming & Growth Speeds | Stand Out Wiki"
  description="Complete Roblox STAND OUT gardening & farming guide. Learn how to get more Garden Pots, get Roka seeds from Big Chop, plant with Dirt & Ice Water, offline growth rules (0.5x PS / 3x Gang Base), and farm 33 Rokakaka mutations."
  canonicalPath="gardening"
  breadcrumbs={[{ label: 'Gardening Guide' }]}
  schemaType="Article"
  dateModified="2026-11-27"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Hero Header + Above-The-Fold MPU -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-8">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
          <span>Gardening &amp; Seed Farming</span>
          <span>•</span>
          <span>Updated Nov 27, 2026 (Update 1 Data)</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          Stand Out Gardening, Seeds &amp; Farming Guide
        </h1>

        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          Everything you need to farm Dalas, boost Garden EXP, and cultivate rare Rokakaka mutations in Roblox <strong>STAND OUT</strong>. Below are instant answers on <strong>getting more Garden Pots</strong>, <strong>getting Roka seeds</strong>, <strong>offline growth speeds</strong>, and full crop visuals.
        </p>

        <AdTopBanner narrow={true} pageType="longSystemGuide" className="mt-6 mb-0" />
      </div>

      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <AdRectangle pageType="longSystemGuide" device="desktop" className="my-0" />
      </div>
    </div>

    <!-- Quick-Answer Cards for Top GSC Gardening Searches -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200">
        <span class="text-[11px] font-black uppercase tracking-wider text-emerald-800">More Garden Pots</span>
        <h2 class="font-black text-sm text-slate-900 mt-1">How to Get More Pots</h2>
        <p class="text-xs text-slate-700 mt-1 leading-relaxed">
          Buy personal <strong>Garden Pots</strong> from <strong>Big Chop</strong> or craft them with Wood + Steel at a Crafting Station. Gang Bases display pot ownership and allow removing others' empty pots.
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200">
        <span class="text-[11px] font-black uppercase tracking-wider text-amber-800">Growth Speed Rules</span>
        <h2 class="font-black text-sm text-slate-900 mt-1">Do Plants Grow Offline?</h2>
        <p class="text-xs text-slate-700 mt-1 leading-relaxed">
          <strong>No offline growth</strong>—stay in an active server. <strong>Public: 1x</strong> • <strong>Private Server: 0.5x</strong> (up from 0.25x on Nov 22) • <strong>Gang Base: 2x</strong> • <strong>Rokakaka Room (Public only): 3x</strong>!
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-purple-50 border border-purple-200">
        <span class="text-[11px] font-black uppercase tracking-wider text-purple-800">Seed Farming</span>
        <h2 class="font-black text-sm text-slate-900 mt-1">How to Get Roka Seeds</h2>
        <p class="text-xs text-slate-700 mt-1 leading-relaxed">
          Purchase from <strong>Big Chop</strong>, finish <strong>Big Chop's Daily Garden</strong> quest, defend <strong>FSA Raids</strong> (+1 Random Seed), or harvest crops (+5% seed return; harvesting now works even at seed cap!).
        </p>
      </div>
    </div>

    <AdRectangle pageType="longSystemGuide" device="mobile" className="my-6" />

    <!-- Location & Facility Showcase -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
      {[
        { src: '/images/gardening/big-chops-garden.webp', title: "Big Chop's Garden", sub: 'Unlock supplies, daily quest & selling Rokas at night' },
        { src: '/images/gardening/garden-pots-overview.webp', title: 'Planted Pots & Plots', sub: 'Spawn garden + Gang Base greenhouse plots' },
        { src: '/images/gardening/mixing-station.webp', title: 'Mixing Station', sub: 'Combine fruits & additives (No Emerald/Opal splash)' },
        { src: '/images/gardening/packaging-station.webp', title: 'Packaging Station', sub: 'Seal fruit into Jars (+20% Nov 22 harvest value)' },
      ].map((card) => (
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs flex flex-col">
          <div class="aspect-video bg-slate-100">
            <ImageModal
              client:load
              src={card.src}
              alt={`${card.title} in Roblox STAND OUT`}
              title={card.title}
              subtitle={card.sub}
              className="w-full h-full"
            />
          </div>
          <div class="p-3">
            <h3 class="font-black text-xs text-slate-900">{card.title}</h3>
            <p class="text-[11px] text-slate-600 mt-0.5">{card.sub}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- 5-Step Complete Workflow + Supplies -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-12">
      <section class="lg:col-span-3 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-5">
        <h2 class="text-2xl font-black text-slate-900">How Gardening Works (Step-by-Step)</h2>
        <div class="space-y-4 text-xs text-slate-600 leading-relaxed">
          {[
            { n: 1, title: 'Unlock & Supply at Big Chop’s Garden', desc: 'Visit Big Chop to buy Garden Pots, Dirt Bags ($100), Ice Water ($50), Mysterious Fertilizer, and Seeds. Pick up Big Chop’s Daily Garden quest (place pot, add dirt, plant, harvest) for a daily bonus seed.' },
            { n: 2, title: 'Place Pots in Public Gang Greenhouse (3x)', desc: 'Avoid slow 0.5x Private Servers for Rokas. Plant inside a Public Gang Base Rokakaka Growing Room for 3x Roka growth speed—ideally with the Fruit Company faction for extra mutation speed.' },
            { n: 3, title: 'Fill Dirt, Plant Seed & Track Drop Minigame', desc: 'Pour Dirt into the pot and plant your seed. Watch the seed/dirt placement tracker added in Update patches to maximize quality grades.' },
            { n: 4, title: 'Water, Fertilize & Channel Hamon / Rain', desc: 'Hydrate with Ice Water, add Mysterious Fertilizer, keep crops outdoors during Rain (+20% bonus), or cast Jonathan Hamon’s Life-Giving Overdrive (also required for the Hermit Purple quest!) to accelerate ticks.' },
            { n: 5, title: 'Harvest, Jar for Deliveries & Defend FSA Raids', desc: 'Harvesting yields crops + bonus seeds (works even at seed cap per Nov 22!) and rolls 3% for mutated Rokas. Package normal fruits into Jars for Texts Garden Deliveries (haggle for higher Dalas) or sell spare Rokas to Big Chop at night—be ready if the Food Safety Agency inspects!' },
          ].map((step) => (
            <div class="flex items-start gap-3.5">
              <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center shrink-0 text-xs">{step.n}</div>
              <div>
                <h3 class="font-bold text-sm text-slate-900">{step.title}</h3>
                <p class="mt-0.5">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Gardening Supplies Icons -->
      <section class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h2 class="text-lg font-black text-slate-900">Essential Gardening Tools &amp; Soil</h2>
        <div class="space-y-3">
          {supplies.map((sup) => (
            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
              <img
                src={sup.img}
                alt={`${sup.name} gardening item in STAND OUT`}
                width={44}
                height={44}
                loading="lazy"
                class="w-11 h-11 rounded-lg object-contain bg-white border border-slate-200 p-1 shrink-0"
              />
              <div class="text-xs">
                <strong class="text-slate-900 block">{sup.name}</strong>
                <span class="text-[10px] font-mono text-emerald-700 font-bold block">{sup.source}</span>
                <p class="text-[11px] text-slate-600 mt-0.5 leading-snug">{sup.role}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <AdNative pageType="longSystemGuide" className="my-8" />

    <!-- Full Seed & Crop Table with Localized WebP Thumbnails -->
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-12">
      <div class="p-6 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-xl font-black text-slate-900">Complete Seed, Crop &amp; Jar Profit Catalog</h2>
          <p class="text-xs text-slate-500 mt-0.5">Nov 22 Update 1 balanced crop growth rates vs vendor resale and buffed Jar Packaging by +20%.</p>
        </div>
        <a href="/guides/gardening/" class="text-xs font-bold text-emerald-700 hover:underline">Advanced Dalas Profit &amp; Texts Delivery Strategy →</a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
              <th class="py-3 px-4">Crop / Seed</th>
              <th class="py-3 px-4">Growth Speed</th>
              <th class="py-3 px-4">Base Value</th>
              <th class="py-3 px-4">Best Purpose &amp; Synergy</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {crops.map((crop) => (
              <tr class="hover:bg-slate-50">
                <td class="py-3 px-4">
                  <div class="flex items-center gap-2.5">
                    <img
                      src={crop.img}
                      alt={`${crop.name} icon in STAND OUT`}
                      width={32}
                      height={32}
                      loading="lazy"
                      class="w-8 h-8 rounded-lg object-contain bg-slate-100 border border-slate-200 p-0.5 shrink-0"
                    />
                    <span class="font-bold text-slate-900">{crop.name}</span>
                  </div>
                </td>
                <td class="py-3 px-4 font-mono text-slate-600">{crop.growth}</td>
                <td class="py-3 px-4 font-mono font-bold text-emerald-700">{crop.basePrice}</td>
                <td class="py-3 px-4 leading-relaxed">{crop.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mutation Preview & CTA to /rokakaka/ -->
    <section class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 shadow-xl mb-12 space-y-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-amber-400">3% Mutation Pool + Interactive Calculator</span>
          <h2 class="text-xl sm:text-2xl font-black text-white mt-1">All 33 Rokakaka Mutations &amp; Gang Base Greenhouses</h2>
          <p class="text-xs text-slate-300 mt-1 max-w-2xl leading-relaxed">
            Every harvested Rokakaka rolls a <strong>3% mutation chance</strong>. Looking for exact Stand reset probabilities (Emerald), Sub-Ability removal (Sapphire), Opal evolutions, or our batch profit calculator? Open the dedicated Rokakaka &amp; Mutation Mixer hub.
          </p>
        </div>
        <a
          href="/rokakaka/#mixer"
          class="px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs transition-colors shrink-0 text-center"
        >
          Open 33 Roka Mutation Mixer →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {featuredMutations.map((m) => (
          <a href="/rokakaka/" class="p-3 rounded-xl bg-slate-800/80 border border-slate-700 hover:border-emerald-400 transition-colors flex items-center gap-3">
            <img
              src={m.img}
              alt={m.name}
              width={40}
              height={40}
              loading="lazy"
              class="w-10 h-10 rounded-lg object-cover bg-slate-900 shrink-0"
            />
            <div class="text-xs">
              <strong class="text-white block">{m.name}</strong>
              <span class="text-[11px] text-slate-300 leading-snug block">{m.note}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
      <h2 class="text-2xl font-black text-slate-900 mb-6">Gardening Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {gardeningFaqs.map((faq) => (
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h3 class="font-bold text-sm text-slate-900 mb-1.5">{faq.q}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import CodeCard from '../components/CodeCard';
import { recentCodes, expiredCodes } from '../data/codes';

import AdLeaderboard from '../components/ads/AdLeaderboard.astro';
import AdNative from '../components/ads/AdNative.astro';
---

<Layout
  title="Stand Out Codes (November 2026) – Working Roblox Codes & Rewards"
  description="Redeem active Roblox STAND OUT codes for November 2026: 100KLIKESHUGE, SORRY4SHUTDOWN, and 50KLIKES. Get free Lucky Arrows, Mysterious Arrows, and Dalas cash with our verified redemption guide."
  canonicalPath="codes"
  breadcrumbs={[{ label: 'Codes' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>Updated for November 2026</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Roblox Stand Out Codes (November 2026)
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Looking for the latest free promo codes for Roblox <strong>STAND OUT</strong>? Below you will find every active and recent code for free Lucky Arrows, Mysterious Arrows, and Dalas cash. Copy any code and redeem it directly inside the in-game Smartphone app.
      </p>
    </div>

    <!-- Top Above-The-Fold Adsterra Responsive Leaderboard -->
    <AdLeaderboard className="mb-10" />

    <!-- Stand Out Codes Section (Active & Recent) -->
    <section class="mb-14">
      <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-6">
        <div>
          <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
            <span>Stand Out Codes</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-mono font-bold">
              {recentCodes.length} Available
            </span>
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Click any code to instantly copy it to your clipboard.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {recentCodes.map((c) => (
          <CodeCard client:load code={c} />
        ))}
      </div>
    </section>

    <!-- Mid-Page Adsterra Native Banner -->
    <AdNative className="my-10" />

    <!-- Expired Codes Section -->
    {expiredCodes.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-6">
          <div>
            <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
              <span>Expired Stand Out Codes</span>
              <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-mono font-bold">
                {expiredCodes.length} Expired
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">These codes have concluded their promotional period and no longer grant rewards.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {expiredCodes.map((c) => (
            <CodeCard client:load code={c} />
          ))}
        </div>
      </section>
    )}

    <!-- How to Redeem Codes in Stand Out -->
    <section class="mb-14 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
      <div class="max-w-2xl mb-6">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-700">Tutorial</span>
        <h2 class="text-2xl font-black text-slate-900 mt-1">How to Redeem Codes in Stand Out</h2>
        <p class="text-xs text-slate-500 mt-1">
          STAND OUT handles code redemption through the in-game Smartphone item rather than on-screen buttons.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center text-sm mb-3">
            1
          </div>
          <h3 class="font-extrabold text-sm text-slate-900">Unlock the Smartphone</h3>
          <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
            Complete early storyline delivery objectives in Honolulu. NPC <strong>Meryl Mei Qi</strong> rewards you with your permanent Smartphone item.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center text-sm mb-3">
            2
          </div>
          <h3 class="font-extrabold text-sm text-slate-900">Open the "Gifts" App</h3>
          <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
            Equip your Smartphone from your hotbar (or press `M` on PC). Look for the gift box icon labeled <strong>Gifts (Codes)</strong>.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black flex items-center justify-center text-sm mb-3">
            3
          </div>
          <h3 class="font-extrabold text-sm text-slate-900">Enter Code &amp; Redeem</h3>
          <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
            Paste your code into the text field and click <strong>Redeem</strong>. Your free Arrows and Dalas will be instantly deposited into your inventory.
          </p>
        </div>
      </div>
    </section>

    <!-- Why Codes Are Not Working -->
    <section class="mb-14 bg-slate-50 rounded-2xl border border-slate-200 p-6 md:p-8">
      <div class="max-w-2xl mb-6">
        <span class="text-xs font-black uppercase tracking-wider text-amber-700">Troubleshooting</span>
        <h2 class="text-2xl font-black text-slate-900 mt-1">Why Are My Codes Not Working?</h2>
        <p class="text-xs text-slate-600 mt-1">
          If you receive an error message when submitting a code, check these common causes:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 bg-white rounded-xl border border-slate-200">
          <h3 class="font-bold text-sm text-slate-900 mb-1">1. New Server Instance Required</h3>
          <p class="text-slate-600 leading-relaxed">
            Milestone codes such as <code>50KLIKES</code> are injected on server restart. If you are in an older server running prior patch versions, the code may display as invalid. Simply re-join a fresh public or private server to resolve this.
          </p>
        </div>

        <div class="p-4 bg-white rounded-xl border border-slate-200">
          <h3 class="font-bold text-sm text-slate-900 mb-1">2. Case Sensitivity</h3>
          <p class="text-slate-600 leading-relaxed">
            Roblox promo codes are strictly case-sensitive. All STAND OUT codes use uppercase letters with numbers (e.g. <code>SORRY4SHUTDOWN</code>). Use the copy button above to avoid typing mistakes.
          </p>
        </div>

        <div class="p-4 bg-white rounded-xl border border-slate-200">
          <h3 class="font-bold text-sm text-slate-900 mb-1">3. Leading or Trailing Spaces</h3>
          <p class="text-slate-600 leading-relaxed">
            If you manually highlight and copy a code on mobile, an accidental trailing space can cause the redemption system to register an unrecognized string.
          </p>
        </div>

        <div class="p-4 bg-white rounded-xl border border-slate-200">
          <h3 class="font-bold text-sm text-slate-900 mb-1">4. Promotional Period Ended</h3>
          <p class="text-slate-600 leading-relaxed">
            Certain celebration codes (like <code>THANKYOUHUGERELEASETHANKS</code>) are timed 24-hour drops that deactivate automatically once the milestone celebration closes.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-14">
      <h2 class="text-2xl font-black text-slate-900 mb-6">Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 bg-white rounded-xl border border-slate-200">
          <h3 class="font-extrabold text-sm text-slate-900">How often are new Stand Out codes released?</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            New codes are typically published during emergency restart maintenance, community like milestones (such as 50k and 100k likes), and major content expansions.
          </p>
        </div>

        <div class="p-5 bg-white rounded-xl border border-slate-200">
          <h3 class="font-extrabold text-sm text-slate-900">Can I redeem a code more than once?</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            No. Each promotional code can only be redeemed once per Roblox account.
          </p>
        </div>

        <div class="p-5 bg-white rounded-xl border border-slate-200">
          <h3 class="font-extrabold text-sm text-slate-900">What do Lucky Arrows and Bizarre Arrows do?</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Lucky Arrows boost your odds of awakening Pinnacle and Mythical Stands, while Bizarre Arrows focus rolls into exclusive alternative combat styles.
          </p>
        </div>

        <div class="p-5 bg-white rounded-xl border border-slate-200">
          <h3 class="font-extrabold text-sm text-slate-900">Do I need to spend Robux to claim codes?</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Never. All codes listed on Stand Out Wiki are 100% free to redeem in-game.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

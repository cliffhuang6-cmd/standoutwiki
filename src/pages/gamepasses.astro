---
import Layout from '../layouts/Layout.astro';
import AdTopBanner from '../components/ads/AdTopBanner.astro';
import AdSidebar from '../components/ads/AdSidebar.astro';
import AdNative from '../components/ads/AdNative.astro';

const gamepasses = [
  {
    name: 'Accessory Builder (Builder)',
    cost: '1,000 Robux (Trello) / 800 Robux (Roblox)',
    value: 'Free Path Available',
    desc: 'Unlocks the BUILDER menu from the Main Menu to craft custom accessories and upload UGC-style outfits. Free for Alpha 1/2/3 testers, plus a new free progression unlock path added in Update 1. Pass holders get rank-scaling builder slots, 1-minute autosave, and session recovery (accessory slot bug fixed Nov 24).'
  },
  {
    name: 'Private Server',
    cost: '1,000 Robux (Trello) / 800 Robux (Roblox)',
    value: 'Niche / Check API',
    desc: 'Allows creating private servers (Update 1 raised PS crop growth speed from 0.25x to 0.5x; damage/kill leaderboards are disabled in PS). Note: Roblox API currently flags createVipServersAllowed as false, so verify in-game availability before purchasing.'
  },
  {
    name: 'Pogo Stick',
    cost: '315 Robux (Trello) / 250 Robux (Roblox)',
    value: 'Traversal Utility',
    desc: 'Unlocks the Pogo Stick as a permanent bound item across all character slots for vertical rooftop traversal.'
  },
  {
    name: 'Guitar',
    cost: '200 Robux',
    value: 'Cosmetic / Social',
    desc: 'Grants the Acoustic Guitar bound item, allowing you to play music while walking (cancelled if hit).'
  },
  {
    name: 'Kill Sound',
    cost: '160 Robux',
    value: 'Cosmetic',
    desc: 'Plays a customizable sound effect whenever you eliminate another player in combat.'
  },
  {
    name: 'Emote Slots',
    cost: '80 Robux',
    value: 'Quality of Life',
    desc: 'Adds a second page of 4 extra slots to your emote and emoji wheel.'
  }
];

const devProducts = [
  { name: 'Stand Arrows Bundle (1x / 3x / 9x)', cost: '39 / 79 / 199 Robux', value: 'Skippable (Farmable)', desc: 'Instant Mysterious Arrow bundles. Easily farmed free via quests, bounties, and raid shops.' },
  { name: 'Starter Pack', cost: '399 Robux', value: 'High Starter Value', desc: 'Includes 9x Mysterious Arrows, 1x SSS-Rank Emerald Roka, 2x SSS-Rank Sapphire Roka, and 1 hour of all 3 boosters.' },
  { name: '2x EXP Booster (15m / 1h)', cost: '39 / 396 Robux', value: 'Craftable Alternative', desc: 'Doubles eligible EXP rewards. Note: 2x EXP boosters can also be crafted free using Rokakakas.' },
  { name: '2x Drops Booster (15m / 1h)', cost: '99 / 236 Robux', value: 'Paid Exclusive', desc: 'Doubles eligible item drops (Item Boost). Unlike EXP and Coins, Drops Boosters cannot be crafted.' },
  { name: '2x Coins Booster (15m / 1h)', cost: '39 / 156 Robux', value: 'Craftable Alternative', desc: 'Doubles Dalas coin payouts. Craftable for free via Rokakaka alchemy recipes.' },
  { name: 'SSS-Rank Roka (Emerald / Sapphire)', cost: '80 Robux', value: 'Convenience', desc: 'Guaranteed SSS-Rank Emerald or Sapphire Rokakaka for instant Stand or Sub-Ability cleansing.' },
  { name: 'Individual Emotes & Emojis', cost: '25 Robux (or 500 Coins)', value: 'Cosmetic', desc: 'Unlocks individual emotes or chat emojis (in-game store lists 25 Robux; some item cards list 500 coins / 39 Robux).' }
];
---

<Layout
  title="Stand Out Gamepasses & Robux Shop – Prices, Builder Free Path & Perks | Stand Out Wiki"
  description="Verified Robux prices for all 6 Roblox STAND OUT gamepasses and developer products. Includes Trello vs Roblox Store prices, the free Builder unlock path, and F2P value analysis."
  canonicalPath="gamepasses"
  breadcrumbs={[{ label: 'Gamepasses & Shop' }]}
  schemaType="Article"
  dateModified="2026-11-26"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-9 min-w-0">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Monetization &amp; Economy</span>
        <span>•</span>
        <span>Verified Nov 26, 2026</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Gamepasses &amp; Robux Shop Guide
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Studio Umbra designed Roblox <strong>STAND OUT</strong> to be 100% playable free-to-play—there is no paid access. Below are all <strong>6 permanent Gamepasses</strong> and <strong>Developer Products</strong> with verified Trello and Roblox Store prices, including the new <strong>Free Builder unlock path</strong> introduced in Update 1.
      </p>
    </div>

    <AdTopBanner narrow={true} pageType="narrowGuide" className="mb-8 mt-0" />

    <!-- Free Builder Path Callout -->
    <div class="mb-10 p-6 rounded-2xl bg-violet-50 border border-violet-200 text-violet-950">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full bg-violet-200 text-violet-900 text-xs font-black uppercase tracking-wider">Update 1 + Nov 24 Fix</span>
      </div>
      <h2 class="text-lg font-black text-slate-900">Free Accessory Builder Unlock &amp; Autosave Improvements</h2>
      <p class="text-xs text-violet-900/90 mt-1.5 leading-relaxed">
        Previously exclusive to Alpha 1–3 testers or a 800–1,000 Robux pass, Update 1 added a <strong>free in-game progression path to unlock Accessory Builder</strong> alongside rank-scaling builder slots for pass holders, <strong>1-minute automatic progress saving</strong>, persistent session state when closing Builder, and a November 24 fix for the builder accessory slot. Upload limit is 5 items.
      </p>
    </div>

    <!-- Permanent Gamepasses -->
    <div class="mb-12">
      <h2 class="text-2xl font-black text-slate-900 mb-4">All 6 Permanent Gamepasses</h2>
      <div class="space-y-4">
        {gamepasses.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                <h3 class="text-base font-black text-slate-900">{item.name}</h3>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-amber-100 text-amber-900 border border-amber-200">
                  {item.cost}
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-1.5 leading-relaxed max-w-xl">
                {item.desc}
              </p>
            </div>

            <div class="shrink-0">
              <span class={`px-3 py-1 rounded-full text-xs font-bold ${
                item.value === 'Free Path Available' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-700'
              }`}>
                {item.value}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Developer Products -->
    <div class="mb-12">
      <h2 class="text-2xl font-black text-slate-900 mb-4">Single-Purchase Developer Products</h2>
      <div class="space-y-4">
        {devProducts.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2.5">
                <h3 class="text-sm font-black text-slate-900">{item.name}</h3>
                <span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-100 text-slate-800 border border-slate-200">
                  {item.cost}
                </span>
              </div>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed max-w-xl">
                {item.desc}
              </p>
            </div>

            <div class="shrink-0">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                {item.value}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <AdNative pageType="narrowGuide" className="my-8" />

    <!-- F2P Assessment -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 shadow-xl">
      <h3 class="text-lg font-black text-amber-400 mb-2">Free-to-Play Verdict &amp; Community Rewards</h3>
      <p class="text-xs text-slate-300 leading-relaxed">
        You do <strong>not</strong> need to spend Robux to reach Level 75, craft Bizarre Arrows, unlock Builder, or evolve into SPTW. Every Stand and 2x EXP/Coin booster can be earned free in-game, and three one-time Community Rewards (Favorite + Like, Group Join, Friend Invite) each award <strong>1 Stand Arrow + 500 Coins</strong>.
      </p>
    </div>
      </div>

      <aside class="lg:col-span-3 flex flex-col items-center lg:items-end space-y-6">
        <AdSidebar size="160x300" pageType="narrowGuide" sticky={true} className="my-0" />
      </aside>
    </div>
  </div>
</Layout>

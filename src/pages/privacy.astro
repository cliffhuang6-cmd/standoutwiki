---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site';

import AdsterraBanner from '../components/AdsterraBanner.astro';
---

<Layout
  title="Privacy Policy – Stand Out Wiki | Stand Out Wiki"
  description="Privacy policy and data handling practices for Stand Out Wiki (standoutwiki.org)."
  canonicalPath="privacy"
  breadcrumbs={[{ label: 'Privacy Policy' }]}
  schemaType="Article"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <h1 class="text-3xl font-black text-slate-900 mb-6">Privacy Policy</h1>
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6 text-xs text-slate-600 leading-relaxed">
      <p>Last updated: November 16, 2026</p>

      <h2 class="text-base font-bold text-slate-900">1. Information We Collect</h2>
      <p>
        Stand Out Wiki (<a href={siteConfig.url} class="text-emerald-700 underline font-semibold">standoutwiki.org</a>) does not require user accounts, passwords, or personal identity verification. We do not sell or monetize personal user data.
      </p>

      <h2 class="text-base font-bold text-slate-900">2. Local Storage Usage</h2>
      <p>
        Interactive utilities (such as the 225-point Build Maker and Arrow Probability Calculator) store your custom build preferences locally inside your browser's Local Storage for your convenience. This data is never sent to our servers.
      </p>

      <h2 class="text-base font-bold text-slate-900">3. Analytics &amp; Cookies</h2>
      <p>
        We utilize standard aggregated web performance tools (such as Google Analytics 4 and Microsoft Clarity) solely in production to analyze aggregate visitor traffic, popular guides, and mobile layout usability. These tools operate strictly in production and do not capture sensitive personal information.
      </p>

      <h2 class="text-base font-bold text-slate-900">4. Contact &amp; Inquiries</h2>
      <p>
        If you have questions regarding this privacy policy or wish to submit feedback, contact our team at: <a href={`mailto:${siteConfig.contactEmail}`} class="text-emerald-700 font-bold underline">{siteConfig.contactEmail}</a>.
      </p>
    </div>

    <!-- Top Above-The-Fold Adsterra Native Banner -->
    <AdsterraBanner className="mb-10" />
  </div>
</Layout>

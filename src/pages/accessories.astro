---
import Layout from '../layouts/Layout.astro';
import { accessories } from '../data/accessories';

const setAccessories = accessories.filter((a) => a.setBonus);
const standaloneAccessories = accessories.filter((a) => !a.setBonus);

import AdLeaderboard from '../components/ads/AdLeaderboard.astro';
import AdNative from '../components/ads/AdNative.astro';
---

<Layout
  title="Stand Out Accessories & Set Bonuses – Stats, Drops & Gear Guide | Stand Out Wiki"
  description="Complete guide to accessories and gear set bonuses in Roblox STAND OUT. View stat buffs for DIO's Set, Jotaro's Set, SWAT Armor, and D'Arby's Dalas set."
  canonicalPath="accessories"
  breadcrumbs={[{ label: 'Accessories' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold mb-3 border border-emerald-200">
        <span>Equipment &amp; Synergies</span>
        <span>•</span>
        <span>Verified Set Bonuses</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Stand Out Accessories &amp; Gear Sets
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Accessories in Roblox <strong>STAND OUT</strong> grant substantial flat stat boosts to Health, Damage, and Ability attributes. Equipping matching 2-piece sets triggers powerful synergistic set bonuses like extended Time Stop or permanent walkspeed buffs.
      </p>
    </div>

    <!-- Top Above-The-Fold Adsterra Responsive Leaderboard -->
    <AdLeaderboard className="mb-10" />

    <!-- Set Bonuses Showcase -->
    <section class="mb-14">
      <h2 class="text-2xl font-black text-slate-900 mb-6">Synergistic Gear Sets</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {setAccessories.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 transition-all">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-amber-100 text-amber-900">
                  {item.setBonus?.setName}
                </span>
              </div>

              <h3 class="text-base font-black text-slate-900 mt-1">{item.name}</h3>

              <!-- Flat Stat Bonuses -->
              <div class="my-3 flex flex-wrap gap-2 text-xs font-mono font-bold">
                {item.bonuses.ability && <span class="px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200">+{item.bonuses.ability} Ability</span>}
                {item.bonuses.damage && <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200">+{item.bonuses.damage} Damage</span>}
                {item.bonuses.health && <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-800 border border-rose-200">+{item.bonuses.health} HP</span>}
              </div>

              <p class="text-xs text-slate-500">
                <strong>Drops From:</strong> {item.dropsFrom}
              </p>
            </div>

            {item.setBonus && (
              <div class="mt-4 pt-3 border-t border-slate-100 text-xs bg-amber-50/50 p-3 rounded-xl border border-amber-100">
                <span class="font-bold text-amber-900 block mb-0.5">2-Piece Set Bonus:</span>
                <p class="text-amber-800 font-semibold">{item.setBonus.effect}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Mid-Page Adsterra Native Banner -->
    <AdNative className="my-10" />

    <!-- Standalone Accessories -->
    <section>
      <h2 class="text-2xl font-black text-slate-900 mb-6">Special Standalone Accessories</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {standaloneAccessories.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 transition-all">
            <div>
              <h3 class="text-base font-black text-slate-900">{item.name}</h3>
              <!-- Flat Stat Bonuses -->
              <div class="my-2.5 flex flex-wrap gap-2 text-xs font-mono font-bold">
                {item.bonuses.ability && <span class="px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200">+{item.bonuses.ability} Ability</span>}
                {item.bonuses.damage && <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200">+{item.bonuses.damage} Damage</span>}
                {item.bonuses.health && <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-800 border border-rose-200">+{item.bonuses.health} HP</span>}
              </div>
              {item.bonuses.special && (
                <p class="text-xs font-semibold text-emerald-800 bg-emerald-50 p-2.5 rounded-lg border border-emerald-200 mt-2">
                  {item.bonuses.special}
                </p>
              )}
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500">
              <strong>Source:</strong> {item.dropsFrom}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';

---

<Layout
  title="How to Get Vampire in Stand Out – Stone Mask & Night Survival | Stand Out Wiki"
  description="Complete Vampire guide for Roblox STAND OUT. Learn how to obtain the Stone Mask, survive daytime sun damage with the Shadow Cloak, and master blood movesets."
  canonicalPath="vampire"
  breadcrumbs={[
    { label: 'Sub-Abilities', href: '/sub-abilities/' },
    { label: 'Vampire Guide' }
  ]}
  schemaType="Article"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-bold mb-3 border border-rose-200">
        <span>Sub-Ability Walkthrough</span>
        <span>•</span>
        <span>Nocturnal Undead Mastery</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        How to Become a Vampire in Stand Out: Complete Guide
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        <strong>Vampire</strong> is the dominant dark fighting style in Roblox <strong>STAND OUT</strong>. Offering unmatched passive health recovery during night cycles, high-freeze melee attacks, and piercing laser eye beams, Vampirism rewards aggressive rushdown playstyles.
      </p>
    </div>

    <!-- How to Become a Vampire -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-6 mb-12">
      <h2 class="text-2xl font-black text-slate-900">Step-by-Step: Obtaining the Stone Mask</h2>

      <div class="space-y-6 text-xs text-slate-600 leading-relaxed">
        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-rose-600 text-white font-black flex items-center justify-center shrink-0">1</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Obtain the Stone Mask Item</h3>
            <p class="mt-1">
              The <strong>Stone Mask</strong> is found as a rare spawn inside the Old Mansion basement chest, or rewarded from high-tier criminal bounty contracts.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-rose-600 text-white font-black flex items-center justify-center shrink-0">2</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Clear Your Sub-Ability Slot</h3>
            <p class="mt-1">
              You cannot awaken as a Vampire if you already have Hamon active. Consume an <strong>Apple</strong> or a <strong>Sapphire Roka</strong> first if needed.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-8 h-8 rounded-lg bg-rose-600 text-white font-black flex items-center justify-center shrink-0">3</div>
          <div>
            <h3 class="font-bold text-sm text-slate-900">Activate with Blood at Night</h3>
            <p class="mt-1">
              Hold the Stone Mask in hand during the night cycle and interact to trigger the bone needle transformation. Your character will emerge with the Vampire moveset and red eyes!
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Core Vampire Mechanics -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <h3 class="font-bold text-sm text-slate-900 mb-2">Nocturnal Regeneration &amp; Blood Gauge</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Vampires possess a unique <strong>Blood Meter</strong> that fills by landing physical strikes or executing Blood Drain. When filled, your passive regeneration restores HP up to 3x faster than normal players.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <h3 class="font-bold text-sm text-slate-900 mb-2">Daylight Protection: The Shadow Cloak</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Vampires take steady solar burn damage when exposed to direct daylight. However, equipping the <strong>Shadow Cloak</strong> accessory (looted from the Old Mansion graveyard chest) completely negates daylight burning!
        </p>
      </div>
    </div>

    <!-- Vampire Moveset -->
    <section class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm space-y-4 mb-12">
      <h2 class="text-xl font-black text-slate-900">Vampire Moveset Directory</h2>

      <div class="space-y-3">
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Space Ripper Stingy Eyes</span>
            <span class="font-mono text-emerald-700 font-bold">28 DMG • 18s CD</span>
          </div>
          <p class="text-xs text-slate-600 mt-1">High-pressure pressurized fluid lasers shot from pupils. Slices through guards.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Vaporizing Freeze</span>
            <span class="font-mono text-emerald-700 font-bold">Freeze Status • 14s CD</span>
          </div>
          <p class="text-xs text-slate-600 mt-1">Freezes body moisture on contact, locking opponents in solid ice for 2.5 seconds.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Blood Drain</span>
            <span class="font-mono text-emerald-700 font-bold">Life Steal • 12s CD</span>
          </div>
          <p class="text-xs text-slate-600 mt-1">Grabs target by the neck, siphoning 30 HP and refilling your entire Blood Gauge.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

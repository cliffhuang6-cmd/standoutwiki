---
import Layout from '../layouts/Layout.astro';
import ImageModal from '../components/ImageModal';
import ArrowCalculator from '../components/ArrowCalculator';
import { items } from '../data/items';

const arrows = items.filter((i) => i.category === 'Arrow');

---

<Layout
  title="Stand Out Arrows – Mysterious, Lucky, Bizarre Rates & Crafting | Stand Out Wiki"
  description="Complete guide to all Stand Arrows in Roblox STAND OUT. Learn how to craft Lucky Arrows and Bizarre Arrows, use Part 3/5 focus arrows, and optimize gacha pulls."
  canonicalPath="stand-arrows"
  breadcrumbs={[{ label: 'Stand Arrows' }]}
  schemaType="CollectionPage"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase tracking-wider mb-3 border border-emerald-200">
        <span>Gacha Mechanics &amp; Recipes</span>
        <span>•</span>
        <span>{arrows.length} Arrow Types</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Stand Out Arrows &amp; Crafting Guide
      </h1>

      <p class="mt-4 text-base text-slate-600 leading-relaxed font-medium">
        Stand Arrows are the core progression catalysts in Studio Umbra's <strong>STAND OUT</strong>. Click any arrow graphic to view an enlarged image preview. Learn crafting recipes, token shop requirements, and mathematically optimal rolling strategies.
      </p>
    </div>

    <!-- Arrow Types Catalog -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {arrows.map((arrow) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between hover:border-emerald-400 hover:shadow-md transition-all group" id={arrow.slug}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 text-[11px] font-black uppercase tracking-wider rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200">
                {arrow.rarity || 'Gacha Catalyst'}
              </span>
              {arrow.sellPrice && (
                <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  {arrow.sellPrice}
                </span>
              )}
            </div>

            {/* Enlarged Image Display (160px height) */}
            <div class="w-full h-40 rounded-xl bg-slate-50 border border-slate-200/80 p-3 mb-5 flex items-center justify-center overflow-hidden">
              <ImageModal
                client:load
                src={arrow.image || '/images/arrows/mysterious-arrow.webp'}
                alt={arrow.name}
                title={arrow.name}
                subtitle={`${arrow.rarity || 'Catalyst'} • ${arrow.sellPrice || 'Special Item'}`}
                className="w-full h-full flex items-center justify-center"
              />
            </div>

            <h2 class="text-lg font-black text-slate-900 group-hover:text-emerald-800 transition-colors">
              {arrow.name}
            </h2>

            <div class="mt-1.5 mb-4 p-2.5 bg-slate-50 rounded-lg border border-slate-100 text-xs text-slate-600">
              <span class="font-bold text-slate-800 block text-[11px] uppercase tracking-wider mb-0.5">
                📍 Obtainment:
              </span>
              <p class="leading-relaxed">{arrow.obtainMethod}</p>
            </div>

            <p class="text-sm text-slate-700 leading-relaxed mb-4">
              {arrow.description}
            </p>
          </div>

          {arrow.uses && arrow.uses.length > 0 && (
            <div class="pt-4 border-t border-slate-100 text-xs text-slate-600">
              <span class="font-bold text-slate-800 uppercase tracking-wider text-[11px] block mb-2">
                Gacha Properties:
              </span>
              <ul class="space-y-1.5">
                {arrow.uses.map((use) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                    <span class="leading-relaxed">{use}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Interactive Calculator Embed -->
    <div class="mb-16">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-700">Interactive Web Tool</span>
        <h2 class="text-3xl font-black text-slate-900 mt-1">Arrow Probability Simulator</h2>
        <p class="text-sm text-slate-500 mt-2">
          Calculate your exact cumulative statistical chance of pulling Pinnacle or Mythical Stands across Mysterious, Lucky, and Bizarre Arrows.
        </p>
      </div>

      <ArrowCalculator client:visible />
    </div>

    <!-- Crafting Guide -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
      <h2 class="text-2xl font-black text-slate-900">How to Craft Summon Arrows</h2>
      <p class="text-sm text-slate-700 leading-relaxed">
        Crafting higher-tier summon arrows is essential to bypass common and rare filler rolls. You do not need to rely purely on random world drops.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-600">
        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 text-sm mb-2">Crafting Lucky Arrows</h3>
          <p class="leading-relaxed mb-3">
            Approach any <strong>Advanced Crafting Bench</strong> located in the Industrial District or Beach Warehouse. Deposit <strong>1 Mysterious Arrow</strong>, <strong>10 Scrap Metal</strong> (salvaged from scrap cars), and <strong>3 Gold Ingots</strong>. The crafting process takes 30 seconds.
          </p>
          <div class="p-3 bg-white rounded-lg border border-slate-200 font-mono text-[11px] text-emerald-800">
            Formula: 1x Mysterious Arrow + 10x Scrap + 3x Gold Ingots = 1x Lucky Arrow
          </div>
        </div>

        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200">
          <h3 class="font-bold text-slate-900 text-sm mb-2">Forging Bizarre Arrows</h3>
          <p class="leading-relaxed mb-3">
            Visit the <strong>Master Forge</strong> near the Catacombs. Combine <strong>3 Lucky Arrows</strong>, <strong>1 Refined Meteorite Shard</strong> (from meteor strike events), and <strong>$50,000 Dalas</strong>. Forging guarantees an Epic, Legendary, Mythical, or Pinnacle tier Stand.
          </p>
          <div class="p-3 bg-white rounded-lg border border-slate-200 font-mono text-[11px] text-purple-800">
            Formula: 3x Lucky Arrows + 1x Meteorite Shard + $50k Dalas = 1x Bizarre Arrow
          </div>
        </div>
      </div>
    </section>

    <!-- Story Progression Lock Warning -->
    <section class="mt-12 p-6 sm:p-8 rounded-2xl bg-amber-50/70 border border-amber-200">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-md bg-amber-200 text-amber-900 text-xs font-black uppercase tracking-wider">
          Crucial Stand Pool Rule
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-amber-950">
        Story-Locked Utility Stands (41 Standard Arrow Pool)
      </h2>
      <p class="text-xs sm:text-sm text-amber-900/90 mt-2 leading-relaxed">
        Out of the 51 live Stands in STAND OUT, <strong>7 utility Stands cannot be rolled from early arrows</strong> until you complete the main story progression:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 text-xs font-bold text-amber-950">
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Super Fly</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Rolling Stones</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Cinderella</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Burning Down the House</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Catch the Rainbow</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Strength</div>
        <div class="p-2.5 rounded-lg bg-white/80 border border-amber-200">Lyin' Eyes</div>
        <div class="p-2.5 rounded-lg bg-emerald-100 text-emerald-900 border border-emerald-300">Beat Story First!</div>
      </div>
      <p class="text-xs text-amber-900/80 mt-3">
        Do not waste Lucky or Bizarre Arrows trying to roll Burning Down the House or Cinderella on a fresh character! Complete Chapters 1 through 10 of the story campaign first to unlock their entry into your arrow summon pool.
      </p>
    </section>
  </div>
</Layout>

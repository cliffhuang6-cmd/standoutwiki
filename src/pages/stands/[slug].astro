---
import Layout from '../../layouts/Layout.astro';
import ImageModal from '../../components/ImageModal';
import AdTopBanner from '../../components/ads/AdTopBanner.astro';
import AdRectangle from '../../components/ads/AdRectangle.astro';
import AdSidebar from '../../components/ads/AdSidebar.astro';
import AdNative from '../../components/ads/AdNative.astro';
import { stands } from '../../data/stands';
import type { Stand } from '../../types';

export function getStaticPaths() {
  return stands.map((stand) => ({
    params: { slug: stand.slug },
    props: { stand },
  }));
}

interface Props {
  stand: Stand;
}

const { stand } = Astro.props;

const rarityBadgeClasses: Record<string, string> = {
  Pinnacle: 'bg-rose-100 text-rose-800 border-rose-200',
  Exclusive: 'bg-violet-100 text-violet-900 border-violet-200',
  Historical: 'bg-slate-200 text-slate-800 border-slate-300',
  Mythical: 'bg-amber-100 text-amber-900 border-amber-200',
  Legendary: 'bg-purple-100 text-purple-900 border-purple-200',
  Epic: 'bg-sky-100 text-sky-900 border-sky-200',
  Rare: 'bg-emerald-100 text-emerald-900 border-emerald-200',
  Evolution: 'bg-teal-100 text-teal-900 border-teal-200',
  'Alternative Universe': 'bg-indigo-100 text-indigo-900 border-indigo-200',
  Quest: 'bg-blue-100 text-blue-900 border-blue-200',
};

const relatedStands = stands
  .filter((s) => s.slug !== stand.slug && (s.jojoPart === stand.jojoPart || s.rarity === stand.rarity))
  .slice(0, 4);

const pageTitle = stand.seoTitle || `${stand.name} – How to Get, Moveset & Build | Stand Out Wiki`;
const pageDescription =
  stand.seoDescription ||
  `Complete guide to ${stand.name} in Roblox STAND OUT. View full moveset, keybinds, cooldowns, Ability scaling, optimal Lv75 (225 SP) builds, and obtainment.`;

const faqSchema =
  stand.faqs && stand.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: stand.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.a,
          },
        })),
      }
    : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`stands/${stand.slug}`}
  ogImage={`https://standoutwiki.org${stand.image}?v=2`}
  ogType="article"
  breadcrumbs={[
    { label: 'Stands', href: '/stands/' },
    { label: stand.name }
  ]}
  schemaType="Article"
  dateModified={stand.verifiedDate}
>
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Top Above-The-Fold Leaderboard (728x90 Desktop / 320x50 Mobile) -->
    <AdTopBanner pageType="standDetail" className="mt-0 mb-6" />

    {stand.status === 'Historical' && (
      <div class="mb-8 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-start gap-3 shadow-xs">
        <span class="text-xl leading-none">⚠️</span>
        <div>
          <strong class="font-black">Historical / Pre-Rework Reference Archive:</strong> {stand.name} is currently archived and removed from active Arrow summon tables pending an official gameplay rework. The stats, abilities, and mechanics below describe the verified pre-rework reference kit.
        </div>
      </div>
    )}

    <!-- Stand Entity Hero Banner -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 md:p-10 shadow-sm mb-10">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-center justify-between">
        <!-- Stand Visual (Left) -->
        <div class="w-full lg:w-5/12 flex justify-center shrink-0">
          <div class="relative w-full max-w-sm aspect-square rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 shadow-md">
            <img
              src={`${stand.image}?v=2`}
              alt={`${stand.name} character pose in Roblox STAND OUT`}
              width={500}
              height={500}
              class="w-full h-full object-cover object-top"
              loading="eager"
            />
            <span class={`absolute top-3 right-3 px-3 py-1 text-xs font-black uppercase tracking-wider rounded-lg border shadow-sm ${
              rarityBadgeClasses[stand.rarity] || 'bg-slate-100 text-slate-800'
            }`}>
              {stand.rarity}
            </span>
          </div>
        </div>

        <!-- Stand Overview Details (Right) -->
        <div class="w-full lg:w-7/12 space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 font-bold text-xs">
              {stand.jojoPart}
            </span>
            <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 font-bold text-xs">
              {stand.combatRole} Role
            </span>
            <span class="px-2.5 py-1 rounded-md bg-slate-900 text-white font-mono text-xs font-bold">
              {stand.status} • Verified {stand.verifiedDate}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
            {stand.name}
          </h1>

          <p class="text-sm font-semibold text-slate-600">
            Canonical User: <strong class="text-slate-900">{stand.canonicalUser}</strong>
          </p>

          <!-- Lore Quote -->
          <blockquote class="p-4 rounded-xl bg-slate-50 border-l-4 border-emerald-600 text-xs text-slate-700 italic leading-relaxed">
            "{stand.lore}"
          </blockquote>

          <!-- Tier Ratings Grid -->
          <div class="pt-1 grid grid-cols-3 gap-3">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-[11px] font-bold text-slate-500 uppercase block">PvP Tier</span>
              <span class="text-xl font-black font-mono text-rose-600">{stand.tier.pvp}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-[11px] font-bold text-slate-500 uppercase block">Raid Tier</span>
              <span class="text-xl font-black font-mono text-emerald-600">{stand.tier.raid}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-[11px] font-bold text-slate-500 uppercase block">Farming Tier</span>
              <span class="text-xl font-black font-mono text-amber-600">{stand.tier.farming}</span>
            </div>
          </div>

          <!-- Obtainment Summary -->
          <div class="pt-1 p-3.5 rounded-xl bg-emerald-50/70 border border-emerald-200">
            <span class="text-xs font-black uppercase tracking-wider text-emerald-900 block mb-1">
              How to Get {stand.name}:
            </span>
            <p class="text-xs text-slate-800 leading-relaxed font-medium">
              {stand.obtainMethod}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Hero-Bottom MPU (300x250) -->
    <AdRectangle pageType="standDetail" device="mobile" className="my-6" />

    {/* Contextual Special Banners */}
    {stand.slug === 'star-platinum' && (
      <div class="mb-10 p-5 rounded-2xl bg-purple-50 border border-purple-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-purple-700 bg-purple-100 px-2 py-0.5 rounded">Stand Evolution Available</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Awaken into Star Platinum: The World (SPTW)</h3>
          <p class="text-xs text-slate-600 mt-0.5">Consume an Opal Rokakaka with Star Platinum active to awaken extended Time Stop, Beatdown, and Platinum Parry.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/evolve-stands/" class="px-4 py-2 rounded-xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-700 transition-colors">
            SPTW Guide →
          </a>
          <a href="/stands/star-platinum-the-world/" class="px-4 py-2 rounded-xl bg-white border border-purple-300 text-purple-800 font-bold text-xs hover:bg-purple-50 transition-colors">
            SPTW Moveset →
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'star-platinum-the-world' && (
      <div class="mb-10 p-5 rounded-2xl bg-purple-50 border border-purple-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-purple-700 bg-purple-100 px-2 py-0.5 rounded">Evolution Origin</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Awakened Form of Star Platinum</h3>
          <p class="text-xs text-slate-600 mt-0.5">Unlocked by consuming an Opal Rokakaka with Star Platinum active.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/evolve-stands/" class="px-4 py-2 rounded-xl bg-purple-600 text-white font-bold text-xs hover:bg-purple-700 transition-colors">
            Evolution Guide →
          </a>
          <a href="/stands/star-platinum/" class="px-4 py-2 rounded-xl bg-white border border-purple-300 text-purple-800 font-bold text-xs hover:bg-purple-50 transition-colors">
            Base Star Platinum →
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'the-world' && (
      <div class="mb-10 p-5 rounded-2xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-2 py-0.5 rounded">Alternative Universe</span>
          <h3 class="text-base font-black text-slate-900 mt-1">The World: Alternative Universe (TWAU)</h3>
          <p class="text-xs text-slate-600 mt-0.5">Looking for Diego Brando's ranged gun and wire-trap variant? View the TWAU moveset and evolution requirements.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/evolve-stands/" class="px-4 py-2 rounded-xl bg-amber-600 text-white font-bold text-xs hover:bg-amber-700 transition-colors">
            Evolution Guide →
          </a>
          <a href="/stands/the-world-alternative-universe/" class="px-4 py-2 rounded-xl bg-white border border-amber-300 text-amber-800 font-bold text-xs hover:bg-amber-50 transition-colors">
            TWAU Profile →
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'the-world-alternative-universe' && (
      <div class="mb-10 p-5 rounded-2xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-amber-700 bg-amber-100 px-2 py-0.5 rounded">Alternative Universe</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Diego Brando's Variant of The World</h3>
          <p class="text-xs text-slate-600 mt-0.5">Alternate timeline Stand specialized in revolver shots, razor wire traps, and fast 3.5s Time Stop cooldowns.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/evolve-stands/" class="px-4 py-2 rounded-xl bg-amber-600 text-white font-bold text-xs hover:bg-amber-700 transition-colors">
            Evolution Guide →
          </a>
          <a href="/stands/the-world/" class="px-4 py-2 rounded-xl bg-white border border-amber-300 text-amber-800 font-bold text-xs hover:bg-amber-50 transition-colors">
            Base The World →
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'king-crimson' && (
      <div class="mb-10 p-5 rounded-2xl bg-rose-50 border border-rose-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-rose-700 bg-rose-100 px-2 py-0.5 rounded">Competitive Mastery</span>
          <h3 class="text-base font-black text-slate-900 mt-1">King Crimson: Doppio Mode &amp; Time Erase Guide</h3>
          <p class="text-xs text-slate-600 mt-0.5">Learn the 3-stage frog phone transformation, invincible Time Erase repositioning, and Epitaph counter setups.</p>
        </div>
        <a href="/guides/king-crimson/" class="px-4 py-2 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 transition-colors shrink-0">
          Read KC Guide →
        </a>
      </div>
    )}

    {stand.slug === 'bad-company' && (
      <div class="mb-10 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">Nov 24 Squad Rework</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Bad Company Rework Guide: 180-Stud Maneuver &amp; Airstrike Meta</h3>
          <p class="text-xs text-slate-600 mt-0.5">Explore the 3x Pilot Range overhaul, Flanking + Landmine combos, all-unit Paratroopers, and reworked skins.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/bad-company-rework/" class="px-4 py-2 rounded-xl bg-emerald-600 text-white font-bold text-xs hover:bg-emerald-700 transition-colors">
            Read Rework Guide →
          </a>
          <a href="/tier-list/" class="px-4 py-2 rounded-xl bg-white border border-emerald-200 text-emerald-800 font-bold text-xs hover:bg-emerald-100 transition-colors">
            Tier List
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'hermit-purple' && (
      <div class="mb-10 p-5 rounded-2xl bg-purple-50 border border-purple-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-purple-800 bg-purple-100 px-2 py-0.5 rounded">Quest Unlock + Hamon Synergy</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Billy's Hermit Purple Quest: Jonathan Hamon + Standless + 15 Plants</h3>
          <p class="text-xs text-slate-600 mt-0.5">Train Jonathan Hamon at the Volcano, strip your Stand with an Emerald Roka (bank at D'Arby first), defeat DIO 0/1, and cast Life-Giving Overdrive on 15 Garden plants.</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/guides/hamon/" class="px-4 py-2 rounded-xl bg-purple-700 text-white font-bold text-xs hover:bg-purple-600 transition-colors">
            Hamon Guide →
          </a>
          <a href="/gardening/" class="px-4 py-2 rounded-xl bg-white border border-purple-200 text-purple-800 font-bold text-xs hover:bg-purple-100 transition-colors">
            Gardening Plots
          </a>
        </div>
      </div>
    )}

    {stand.slug === 'dolly-dagger' && (
      <div class="mb-10 p-5 rounded-2xl bg-violet-50 border border-violet-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-violet-800 bg-violet-100 px-2 py-0.5 rounded">1,850 ELO Ranked Exclusive</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Unlock Dolly Dagger via Competitive 1v1 Ranked Mode</h3>
          <p class="text-xs text-slate-600 mt-0.5">Not rollable from Arrows. Reach Level 60+, enter 1v1 Ranked Arena, and climb to 1,850 ELO to permanently claim Dolly Dagger.</p>
        </div>
        <a href="/guides/ranked-mode/" class="px-4 py-2 rounded-xl bg-violet-700 text-white font-bold text-xs hover:bg-violet-600 transition-colors shrink-0">
          1v1 Ranked ELO Guide →
        </a>
      </div>
    )}

    {stand.slug === 'highway-star' && (
      <div class="mb-10 p-5 rounded-2xl bg-sky-50 border border-sky-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-sky-800 bg-sky-100 px-2 py-0.5 rounded">Part 4 Raid Boss &amp; Stand Chip Drop</span>
          <h3 class="text-base font-black text-slate-900 mt-1">Looking for the Highway Star Raid (Part 4 Arrow &amp; Chip)?</h3>
          <p class="text-xs text-slate-600 mt-0.5">Highway Star can be summoned from Mysterious/Lucky/Bizarre Arrows or farmed via Highway Star Stand Chips in the Highway Star Raid.</p>
        </div>
        <a href="/guides/highway-star-raid/" class="px-4 py-2 rounded-xl bg-sky-700 text-white font-bold text-xs hover:bg-sky-600 transition-colors shrink-0">
          Highway Star Raid Guide →
        </a>
      </div>
    )}

    {stand.slug === 'catch-the-rainbow' && (
      <div class="mb-10 p-5 rounded-2xl bg-teal-50 border border-teal-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-black uppercase tracking-wider text-teal-800 bg-teal-100 px-2 py-0.5 rounded">Storyline Lock + Rain Ocarina Fix</span>
          <h3 class="text-base font-black text-slate-900 mt-1">How to Roll Catch The Rainbow &amp; Activate It Without Natural Rain</h3>
          <p class="text-xs text-slate-600 mt-0.5">Beat Storyline Quest 10 first to unlock Catch The Rainbow in Stand Arrows (Blackmore's side quest only rewards a Mysterious Arrow &amp; his outfit!). Use Update 1's Ocarina (5 EX Bars) to summon 30s of rain anywhere.</p>
        </div>
        <a href="/stand-arrows/" class="px-4 py-2 rounded-xl bg-teal-700 text-white font-bold text-xs hover:bg-teal-600 transition-colors shrink-0">
          Arrow Rates &amp; Story Lock →
        </a>
      </div>
    )}

    {/* Visual Ability & Pose Showcase Gallery (when localized screenshots exist) */}
    {stand.showcaseImages && stand.showcaseImages.length > 0 && (
      <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm mb-10">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
          <div>
            <span class="text-[11px] font-black uppercase tracking-wider text-emerald-700">In-Game Screenshots</span>
            <h2 class="text-xl font-black text-slate-900">{stand.name} Ability &amp; Pose Visual Gallery</h2>
          </div>
          <span class="text-xs text-slate-500">Click any preview to enlarge</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {stand.showcaseImages.map((img) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 overflow-hidden flex flex-col">
              <div class="aspect-video bg-slate-900/5 overflow-hidden">
                <ImageModal
                  client:load
                  src={img.src}
                  alt={img.alt}
                  title={img.title}
                  subtitle={img.caption}
                  className="w-full h-full"
                />
              </div>
              <div class="p-3">
                <h3 class="text-xs font-black text-slate-900">{img.title}</h3>
                <p class="text-[11px] text-slate-600 mt-0.5 leading-snug">{img.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left 2 Columns: Moveset, Passives, Combat Guide, Pros/Cons, FAQs -->
      <div class="lg:col-span-2 space-y-10">
        <!-- Moveset Section -->
        <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <div class="flex flex-wrap items-center justify-between pb-4 border-b border-slate-200 mb-6 gap-2">
            <div>
              <h2 class="text-2xl font-black text-slate-900">Complete Moveset &amp; Keybinds</h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Verified PC keybinds (<a href="/guides/controls/" class="text-emerald-700 font-semibold hover:underline">full PC/Xbox/Mobile guide</a>), cooldowns, EX costs &amp; guard rules.
              </p>
            </div>
            <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md">
              {stand.moveset.length} Moves Documented
            </span>
          </div>

          <div class="space-y-4">
            {stand.moveset.map((move) => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-300 transition-colors">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    <kbd class="px-2.5 py-1 bg-slate-900 text-white font-mono font-black text-xs rounded-md shadow-xs">
                      {move.key}
                    </kbd>
                    <h3 class="font-black text-sm text-slate-900">
                      {move.name}
                    </h3>
                  </div>

                  <div class="flex flex-wrap items-center gap-1.5 text-xs">
                    <span class="px-2 py-0.5 rounded bg-slate-200 text-slate-700 font-semibold text-[11px]">
                      {move.type}
                    </span>
                    {move.exCost && (
                      <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold text-[11px]">
                        ⚡ {move.exCost}
                      </span>
                    )}
                    {move.cooldown && (
                      <span class="font-mono text-slate-600 font-bold text-[11px]">
                        ⏱️ {move.cooldown}
                      </span>
                    )}
                    {move.damage && (
                      <span class="font-mono font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded text-[11px]">
                        💥 {move.damage}
                      </span>
                    )}
                    {move.blockable === false && (
                      <span class="px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 font-bold text-[10px]">
                        Guardbreak / Unblockable
                      </span>
                    )}
                    {move.parriable && (
                      <span class="px-1.5 py-0.5 rounded bg-purple-100 text-purple-800 font-bold text-[10px]">
                        Parriable
                      </span>
                    )}
                  </div>
                </div>

                {move.specialEffects && (
                  <p class="text-[11px] font-bold text-emerald-800 mb-1">{move.specialEffects}</p>
                )}

                <p class="text-xs text-slate-600 leading-relaxed mt-1">
                  {move.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Mid-Article Sponsored Native Unit -->
        <AdNative pageType="standDetail" className="my-4" />

        <!-- Passives & Trait Mechanics -->
        <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <h2 class="text-xl font-black text-slate-900 mb-4">Passives &amp; Unique Mechanics</h2>
          <div class="space-y-3">
            {stand.passives.map((passive) => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  {passive.name}
                </h3>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  {passive.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- Ability Stat Scaling -->
        {stand.abilityScaling && (
          <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
            <h2 class="text-xl font-black text-slate-900 mb-2">Stat Scaling &amp; Formula Parameters</h2>
            <p class="text-xs text-slate-500 mb-4">
              How investing stat points into <strong>Ability</strong> and <strong>Strength</strong> directly impacts {stand.name}:
            </p>
            <ul class="space-y-2 text-xs text-slate-700">
              {stand.abilityScaling.map((scale) => (
                <li class="flex items-start gap-2 bg-emerald-50/70 p-3 rounded-lg border border-emerald-100">
                  <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✦</span>
                  <span>{scale}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Stand-Specific Combat Guide: Combos, PvP/PvE, Counters & Mistakes */}
        {stand.combatGuide && (
          <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm space-y-6">
            <div>
              <span class="text-[11px] font-black uppercase tracking-wider text-purple-700">Mastery Blueprint</span>
              <h2 class="text-2xl font-black text-slate-900 mt-0.5">{stand.name} Combos, PvP/PvE &amp; Counterplay</h2>
              <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">{stand.combatGuide.quickSummary}</p>
            </div>

            {stand.combatGuide.bestCombos.length > 0 && (
              <div>
                <h3 class="text-sm font-black text-slate-900 mb-3">Optimal Combo Chains</h3>
                <div class="space-y-2.5">
                  {stand.combatGuide.bestCombos.map((combo) => (
                    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
                      <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                        <strong class="text-xs text-slate-900">{combo.name}</strong>
                        <kbd class="px-2 py-0.5 rounded bg-slate-900 text-white font-mono text-[11px] font-bold">{combo.sequence}</kbd>
                      </div>
                      <p class="text-xs text-slate-600 leading-relaxed">{combo.notes}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-rose-50/60 border border-rose-200">
                <h3 class="font-black text-rose-950 mb-1.5">1v1 PvP &amp; Ranked Playstyle</h3>
                <p class="text-slate-700 leading-relaxed">{stand.combatGuide.pvpStrategy}</p>
              </div>
              <div class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-200">
                <h3 class="font-black text-emerald-950 mb-1.5">Raids, Bosses &amp; Farming Strategy</h3>
                <p class="text-slate-700 leading-relaxed">{stand.combatGuide.pveStrategy}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div class="p-4 rounded-xl bg-amber-50/60 border border-amber-200">
                <h3 class="font-black text-amber-950 mb-2">How to Counter {stand.name}</h3>
                <ul class="space-y-1.5 text-slate-700">
                  {stand.combatGuide.howToCounter.map((c) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-amber-700 font-bold">•</span>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                <h3 class="font-black text-slate-900 mb-2">Common Mistakes to Avoid</h3>
                <ul class="space-y-1.5 text-slate-700">
                  {stand.combatGuide.commonMistakes.map((m) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-rose-600 font-bold">✕</span>
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            {stand.combatGuide.recommendedItems.length > 0 && (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs">
                <h3 class="font-black text-slate-900 mb-1.5">Recommended Accessories &amp; Items</h3>
                <ul class="list-disc list-inside space-y-1 text-slate-700">
                  {stand.combatGuide.recommendedItems.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}

        <!-- Pros & Cons -->
        <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <h2 class="text-xl font-black text-slate-900 mb-4">Strengths &amp; Weaknesses</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-emerald-50/60 border border-emerald-200">
              <h3 class="font-bold text-xs uppercase tracking-wider text-emerald-900 mb-2">
                Pros &amp; Strengths
              </h3>
              <ul class="space-y-1.5 text-xs text-emerald-950">
                {stand.pros.map((pro) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-600 font-bold">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="p-4 rounded-xl bg-rose-50/60 border border-rose-200">
              <h3 class="font-bold text-xs uppercase tracking-wider text-rose-900 mb-2">
                Cons &amp; Limitations
              </h3>
              <ul class="space-y-1.5 text-xs text-rose-950">
                {stand.cons.map((con) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-rose-600 font-bold">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Stand FAQs -->
        <section class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
          <h2 class="text-xl font-black text-slate-900 mb-4">{stand.name} FAQ</h2>
          <div class="space-y-4">
            {stand.faqs.map((faq) => (
              <div class="border-b border-slate-100 pb-3 last:border-0 last:pb-0">
                <h3 class="font-bold text-sm text-slate-900 mb-1">{faq.q}</h3>
                <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Right 1 Column: Recommended Build & Gear -->
      <div class="space-y-8">
        <!-- Recommended Build Card -->
        <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Competitive Recommendation</span>
          <h2 class="text-lg font-black mt-1">Best Lv75 Stat Build (225 SP)</h2>
          <p class="text-xs text-slate-400 mt-1">Recommended distribution for current Level 75 / 225 SP cap (166 single-stat max):</p>

          <div class="mt-5 space-y-3">
            <div class="flex items-center justify-between p-2.5 bg-slate-800 rounded-lg text-xs">
              <span class="text-rose-300 font-semibold">Health Points</span>
              <span class="font-mono font-black text-white">{stand.recommendedBuild.points.health} pts</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-slate-800 rounded-lg text-xs">
              <span class="text-amber-300 font-semibold">Damage Points</span>
              <span class="font-mono font-black text-white">{stand.recommendedBuild.points.damage} pts</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-slate-800 rounded-lg text-xs">
              <span class="text-teal-300 font-semibold">Ability Points</span>
              <span class="font-mono font-black text-white">{stand.recommendedBuild.points.ability} pts</span>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-800">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
              Recommended Sub-Ability:
            </span>
            <a href="/sub-abilities/" class="text-xs font-bold text-emerald-400 hover:underline">
              {stand.recommendedBuild.subAbility} →
            </a>
          </div>

          <div class="mt-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
              Gear &amp; Set Synergy:
            </span>
            <p class="text-xs text-slate-300 leading-relaxed">
              {stand.recommendedBuild.synergyNotes}
            </p>
          </div>

          <div class="mt-6 space-y-2">
            <a
              href={`/guides/level-up-fast/#build-maker?stand=${stand.slug}&h=${stand.recommendedBuild.points.health}&d=${stand.recommendedBuild.points.damage}&a=${stand.recommendedBuild.points.ability}`}
              class="block w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-center font-bold text-xs rounded-xl text-white transition-colors"
            >
              Open in Build Maker Tool →
            </a>
            <a
              href="/accessories/"
              class="block w-full py-2 bg-slate-800 hover:bg-slate-700 text-center font-semibold text-xs rounded-xl text-slate-200 transition-colors"
            >
              Browse Best Accessories &amp; Sets
            </a>
          </div>
        </div>

        <!-- Quick Wiki Links -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-2 text-xs">
          <h2 class="text-sm font-black uppercase tracking-wider text-slate-700 mb-2">Useful Tools &amp; Guides</h2>
          <a href="/stand-arrows/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">Stand Arrows &amp; Summon Odds →</a>
          <a href="/rokakaka/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">Rokakaka Reset &amp; Evolutions →</a>
          <a href="/tier-list/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">Live PvP &amp; Raid Tier List →</a>
          <a href="/guides/controls/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">PC, Console &amp; Mobile Controls →</a>
        </div>

        <!-- Related Stands from same era -->
        {relatedStands.length > 0 && (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
            <h2 class="text-sm font-black uppercase tracking-wider text-slate-700 mb-4">
              Related Stands from {stand.jojoPart.split(':')[0]}
            </h2>
            <div class="space-y-3">
              {relatedStands.map((rel) => (
                <a
                  href={`/stands/${rel.slug}/`}
                  class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-50 transition-colors group"
                >
                  <img
                    src={rel.image}
                    alt={`${rel.name} in STAND OUT`}
                    width={40}
                    height={40}
                    loading="lazy"
                    class="w-10 h-10 object-cover rounded-lg bg-slate-100 border border-slate-200 shrink-0"
                  />
                  <div class="min-w-0 flex-1">
                    <h3 class="font-bold text-xs text-slate-900 group-hover:text-emerald-700 truncate">
                      {rel.name}
                    </h3>
                    <p class="text-[11px] text-slate-500 truncate">{rel.canonicalUser}</p>
                  </div>
                  <span class="text-[10px] font-mono font-bold text-slate-400">
                    {rel.rarity}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Desktop Sticky Skyscraper Sidebar (160x600) -->
        <AdSidebar size="160x600" pageType="standDetail" sticky={true} className="my-2" />
      </div>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import BuildMaker from '../../components/BuildMaker';
import ArrowCalculator from '../../components/ArrowCalculator';
import ControlsReference from '../../components/ControlsReference';
import AdTopBanner from '../../components/ads/AdTopBanner.astro';
import AdRectangle from '../../components/ads/AdRectangle.astro';
import AdSidebar from '../../components/ads/AdSidebar.astro';
import AdNative from '../../components/ads/AdNative.astro';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

// Contextual related guides
const relatedGuides = guides.filter((g) => g.slug !== guide.slug && g.category === guide.category).slice(0, 3);
---

<Layout
  title={`${guide.title} | Stand Out Wiki`}
  description={guide.description}
  canonicalPath={`guides/${guide.slug}`}
  ogType="article"
  breadcrumbs={[
    { label: 'Guides', href: '/guides/' },
    { label: guide.title }
  ]}
  schemaType="Article"
  dateModified={guide.updatedDate}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 min-w-0">
    <!-- Guide Header -->
    <div class="mb-6 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-3 text-xs mb-3">
        <span class="px-2.5 py-1 rounded-full font-black uppercase tracking-wider bg-purple-100 text-purple-800">
          {guide.category}
        </span>
        <span class="text-slate-400 font-semibold">•</span>
        <span class="text-slate-500 font-semibold">{guide.readingTime}</span>
        <span class="text-slate-400 font-semibold">•</span>
        <span class="text-slate-500 font-semibold">Updated {guide.updatedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {guide.title}
      </h1>

      <p class="mt-4 text-base text-slate-600 leading-relaxed font-medium">
        {guide.description}
      </p>
    </div>

    <!-- Above-The-Fold Banner (468x60 Desktop main column / 320x50 Mobile) -->
    <AdTopBanner narrow={true} pageType="guideDetail" className="my-6" />

    <!-- Table of Contents -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm mb-10">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-3">
        Table of Contents
      </h2>
      <ol class="space-y-2 text-xs font-bold text-emerald-800">
        {guide.tableOfContents.map((item, index) => (
          <li>
            <a href={`#${item.id}`} class="hover:underline flex items-center gap-2">
              <span class="text-slate-400 font-mono">{index + 1}.</span>
              <span>{item.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    {/* Controls Interactive Quick-Answer & Platform Switcher */}
    {guide.slug === 'controls' && (
      <div id="interactive-controls" class="scroll-mt-24 mb-12">
        <ControlsReference client:load />
      </div>
    )}

    <!-- Interactive Tool Embed (Contextual) -->
    {(guide.slug === 'lucky-arrows' || guide.slug === 'bizarre-arrows' || guide.slug === 'arrow-rates-explained') && (
      <div id="calculator" class="scroll-mt-24 mb-12">
        <div class="mb-3">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full">
            Interactive Calculator
          </span>
          <h2 class="text-lg font-black text-slate-900 mt-1">Simulate Your Arrow Probabilities</h2>
        </div>
        <ArrowCalculator client:load />
      </div>
    )}

    {(guide.slug === 'level-up-fast' || guide.slug === 'star-platinum' || guide.slug === 'the-world' || guide.slug === 'king-crimson' || guide.slug === 'combat-mechanics') && (
      <div id="build-maker" class="scroll-mt-24 mb-12">
        <div class="mb-3">
          <span class="text-xs font-black uppercase tracking-wider text-purple-800 bg-purple-100 px-2 py-0.5 rounded-full">
            Interactive Stat Calculator
          </span>
          <h2 class="text-lg font-black text-slate-900 mt-1">Plan Your Character Stat Point Distribution (Level 75 / 225 SP Cap)</h2>
        </div>
        <BuildMaker client:load />
      </div>
    )}

    <!-- Mobile MPU Below Quick Reference / TOC (300x250) -->
    <AdRectangle device="mobile" pageType="guideDetail" className="my-6" />

    <!-- Guide Content Sections -->
    <div class="space-y-12 text-sm text-slate-700 leading-relaxed max-w-none">
      {guide.sections && guide.sections.map((section, idx) => (
        <>
        <section id={section.id} class="scroll-mt-24 bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-2xl font-black text-slate-900">
            {idx + 1}. {section.title}
          </h2>
          
          <p class="text-slate-700 leading-relaxed">
            {section.content}
          </p>

          {/* Step-by-Step Checklist */}
          {section.steps && section.steps.length > 0 && (
            <div class="mt-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-600 mb-3">
                Action Steps
              </h3>
              <ol class="space-y-2">
                {section.steps.map((step, sIdx) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-700">
                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white font-bold text-[10px] shrink-0">
                      {sIdx + 1}
                    </span>
                    <span class="pt-0.5">{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {/* Formatted Data Table */}
          {section.table && (
            <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200">
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
                  <tr>
                    {section.table.headers.map((h) => (
                      <th class="px-4 py-3">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-mono">
                  {section.table.rows.map((row) => (
                    <tr class="hover:bg-slate-50 transition-colors">
                      {row.map((cell, cIdx) => (
                        <td class={`px-4 py-2.5 ${cIdx === 0 ? 'font-bold text-slate-900' : 'text-slate-600'}`}>
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Pro Tips */}
          {section.tips && section.tips.length > 0 && (
            <div class="mt-4 p-4 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-950">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-emerald-700 font-black text-xs uppercase tracking-wider">💡 Pro Strategy Tip</span>
              </div>
              <ul class="list-disc list-inside space-y-1 text-xs">
                {section.tips.map((tip) => (
                  <li>{tip}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Warning Alert */}
          {section.warning && (
            <div class="mt-4 p-4 bg-amber-50 rounded-xl border border-amber-200 text-amber-950">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-amber-800 font-black text-xs uppercase tracking-wider">⚠️ Critical Warning</span>
              </div>
              <p class="text-xs leading-relaxed">{section.warning}</p>
            </div>
          )}
        </section>
        {idx === 0 && (
          <AdNative pageType="guideDetail" className="my-6" />
        )}
        </>
      ))}
    </div>

    {/* Contextual Embedded Tool: Build Maker for level-up-fast */}
    {guide.slug === 'level-up-fast' && (
      <div class="mt-12 scroll-mt-24" id="build-maker">
        <div class="mb-4">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-700">Interactive Tool</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Level 75 Stat Point Allocator &amp; Build Maker</h2>
          <p class="text-xs text-slate-500 mt-1">Test attribute allocations up to the 225-point cap (166 single-stat max) and calculate gear synergy bonuses.</p>
        </div>
        <BuildMaker client:load />
      </div>
    )}

    {/* Contextual Cross-Links to Eliminate Cannibalization & Guide Users */}
    {guide.slug === 'controls' && (
      <div class="mt-10 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-emerald-800">Put Your Controls Into Practice</div>
          <p class="text-sm font-bold text-slate-900 mt-0.5">
            Explore full Stand move keybinds, combat combos, or redeem active promo codes via Phone (Z).
          </p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <a href="/stands/" class="px-4 py-2 rounded-xl bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-600 transition-colors">
            All 55 Stands &rarr;
          </a>
          <a href="/codes/" class="px-4 py-2 rounded-xl bg-white border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition-colors">
            Active Codes (Z Key)
          </a>
          <a href="/tier-list/" class="px-4 py-2 rounded-xl bg-white border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition-colors">
            Tier List
          </a>
        </div>
      </div>
    )}

    {guide.slug === 'ranked-mode' && (
      <div class="mt-10 p-5 rounded-2xl bg-violet-50 border border-violet-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-violet-800">1,850 ELO Exclusive Unlock</div>
          <p class="text-sm font-bold text-slate-900 mt-0.5">
            Inspect full moveset frames, 70% damage reflection math, and builds on our Dolly Dagger Stand page.
          </p>
        </div>
        <a href="/stands/dolly-dagger/" class="px-4 py-2 rounded-xl bg-violet-700 text-white text-xs font-bold hover:bg-violet-600 transition-colors shrink-0">
          Dolly Dagger Guide &rarr;
        </a>
      </div>
    )}

    {guide.slug === 'gardening' && (
      <div class="mt-10 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-emerald-800">Master Crop &amp; Mutation Hubs</div>
          <p class="text-sm font-bold text-slate-900 mt-0.5">
            Browse our full visual Gardening &amp; Seeds database or run batch yield math in the 33 Roka Mixer.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <a href="/gardening/" class="px-4 py-2 rounded-xl bg-emerald-700 text-white text-xs font-bold hover:bg-emerald-600 transition-colors">
            Gardening Reference &rarr;
          </a>
          <a href="/rokakaka/" class="px-4 py-2 rounded-xl bg-white border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition-colors">
            33 Roka Mutations
          </a>
        </div>
      </div>
    )}

    {guide.slug === 'bizarre-arrows' && (
      <div class="mt-10 p-5 rounded-2xl bg-purple-50 border border-purple-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-purple-800">Full Arrow &amp; Drop Hub</div>
          <p class="text-sm font-bold text-slate-900 mt-0.5">
            Compare Lucky, Bizarre, Part 3/4/5 Focus Arrows, and Arrow Parts crafting formulas side-by-side.
          </p>
        </div>
        <a href="/stand-arrows/" class="px-4 py-2 rounded-xl bg-purple-700 text-white text-xs font-bold hover:bg-purple-600 transition-colors shrink-0">
          All Stand Arrows &rarr;
        </a>
      </div>
    )}

    {/* Contextual Stand Cross-Links for Bad Company Rework Guide */}
    {guide.slug === 'bad-company-rework' && (
      <div class="mt-10 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-emerald-800">Verified Stand Database</div>
          <p class="text-sm font-bold text-slate-900 mt-0.5">
            Inspect full frame data, EX costs, and reworked skins on the Bad Company Stand page.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <a href="/stands/bad-company/" class="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition-colors">
            Bad Company Stand Page &rarr;
          </a>
          <a href="/tier-list/" class="px-4 py-2 rounded-xl bg-white border border-emerald-200 text-emerald-800 text-xs font-bold hover:bg-emerald-100 transition-colors">
            Tier List
          </a>
        </div>
      </div>
    )}

    {/* Contextual Embedded Tool: Arrow Calculator for arrow guides */}
    {(guide.slug === 'bizarre-arrows' || guide.slug === 'lucky-arrows') && (
      <div class="mt-12 scroll-mt-24" id="calculator">
        <div class="mb-4">
          <span class="text-xs font-black uppercase tracking-wider text-emerald-700">Interactive Tool</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Arrow Drop Rate &amp; Bernoulli Odds Calculator</h2>
          <p class="text-xs text-slate-500 mt-1">Calculate exact probabilities of obtaining your target Stand across multiple arrow rolls.</p>
        </div>
        <ArrowCalculator client:load />
      </div>
    )}

    <!-- Related Guides Footer -->
    {relatedGuides.length > 0 && (
      <div class="mt-16 pt-8 border-t border-slate-200">
        <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-4">
          Related Guides in {guide.category}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedGuides.map((rel) => (
            <a
              href={`/guides/${rel.slug}/`}
              class="p-4 rounded-xl bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-xs transition-all block"
            >
              <h3 class="font-bold text-xs text-slate-900 line-clamp-2">{rel.title}</h3>
              <span class="text-[11px] text-emerald-700 font-semibold mt-2 block">Read Guide →</span>
            </a>
          ))}
        </div>
      </div>
    )}
      </div>

      <!-- Desktop Sticky Right Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <AdRectangle device="desktop" pageType="guideDetail" className="my-0" />

        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-2.5 text-xs">
          <span class="text-[11px] font-black uppercase tracking-wider text-purple-700 block">Quick Navigation</span>
          <h2 class="text-sm font-black text-slate-900">Essential STAND OUT Hubs</h2>
          <a href="/stands/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">All 55 Stands Database →</a>
          <a href="/tier-list/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">PvP &amp; Raid Tier List →</a>
          <a href="/codes/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">Active Working Codes →</a>
          <a href="/stand-arrows/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">Stand Arrows &amp; Drop Odds →</a>
          <a href="/guides/" class="block p-2.5 rounded-lg bg-slate-50 hover:bg-emerald-50 font-bold text-slate-800">All Walkthrough Guides →</a>
        </div>

        <AdSidebar size="160x600" pageType="guideDetail" sticky={true} className="my-2" />
      </aside>
    </div>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import BuildMaker from '../../components/BuildMaker';
import ArrowCalculator from '../../components/ArrowCalculator';
import { guides, guidesBySlug } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

// Contextual related guides
const relatedGuides = guides.filter((g) => g.slug !== guide.slug && g.category === guide.category).slice(0, 3);
---

<Layout
  title={`${guide.title} | Stand Out Wiki`}
  description={guide.description}
  canonicalPath={`guides/${guide.slug}`}
  ogType="article"
  breadcrumbs={[
    { label: 'Guides', href: '/guides/' },
    { label: guide.title }
  ]}
  schemaType="Article"
  dateModified={guide.updatedDate}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Guide Header -->
    <div class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-3 text-xs mb-3">
        <span class="px-2.5 py-1 rounded-full font-black uppercase tracking-wider bg-purple-100 text-purple-800">
          {guide.category}
        </span>
        <span class="text-slate-400 font-semibold">•</span>
        <span class="text-slate-500 font-semibold">{guide.readingTime}</span>
        <span class="text-slate-400 font-semibold">•</span>
        <span class="text-slate-500 font-semibold">Updated {guide.updatedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        {guide.title}
      </h1>

      <p class="mt-4 text-base text-slate-600 leading-relaxed font-medium">
        {guide.description}
      </p>
    </div>

    <!-- Table of Contents -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm mb-12">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-3">
        Table of Contents
      </h2>
      <ol class="space-y-2 text-xs font-bold text-emerald-800">
        {guide.tableOfContents.map((item, index) => (
          <li>
            <a href={`#${item.id}`} class="hover:underline flex items-center gap-2">
              <span class="text-slate-400 font-mono">{index + 1}.</span>
              <span>{item.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <!-- Guide Content Sections -->
    <div class="space-y-12 text-sm text-slate-700 leading-relaxed prose prose-slate max-w-none">
      {guide.slug === 'beginner-guide' && (
        <>
          <section id="first-hour" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">1. The First 15 Minutes</h2>
            <p>
              When you first spawn into Roblox STAND OUT, you start without a Stand. Follow the yellow on-screen waypoint to speak to the Tutorial Instructor. Complete the combat training drills (performing light combos with LMB, blocking with F, and dashing with Q).
            </p>
            <p>
              Upon finishing the tutorial, you are awarded your first <strong>Mysterious Arrow</strong> and 500 Dalas.
            </p>
          </section>

          <section id="first-stand" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">2. Awakening Your First Stand</h2>
            <p>
              Open your backpack, hold the Mysterious Arrow, and click to awaken your Stand. If you roll a Rare tier Stand with solid early-game clearing power (like <em>Yellow Temperance</em> or <em>Beach Boy</em>), keep it! You can always store it later at D'Arby's casino counter.
            </p>
          </section>

          <section id="combat-basics" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">3. Core Combat &amp; Keybinds</h2>
            <p>
              Combat in STAND OUT is high-tempo and precision-based:
            </p>
            <ul class="list-disc list-inside space-y-1 text-xs">
              <li><strong>Light Combo (LMB):</strong> 4-hit basic chain that stuns opponents.</li>
              <li><strong>Heavy Attack (R):</strong> Guardbreak strike that staggers blocking enemies.</li>
              <li><strong>Perfect Block (F):</strong> Tapping block right as an attack connects completely negates damage and parries.</li>
              <li><strong>Pilot Mode (Left Ctrl):</strong> Remotely controls your Stand away from your character body.</li>
              <li><strong>Posing (P):</strong> Regenerates your Awakening/EX meter at 1% per second.</li>
            </ul>
          </section>

          <section id="phone-utility" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">4. Unlocking the Phone &amp; Huber</h2>
            <p>
              Do not wander aimlessly around the massive map. Immediately begin Storyline Quest 1 and proceed to <strong>Storyline Quest 2</strong> with NPC <strong>Meryl Mei Qi</strong>. Completing her driving task rewards you with the permanent Smartphone. The phone unlocks Huber taxi fast travel, mini-map GPS navigation, and the Gifts app used to redeem promo codes!
            </p>
          </section>
        </>
      )}

      {guide.slug === 'controls' && (
        <>
          <section id="pc-keybinds" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">PC Keyboard &amp; Mouse Keybinds</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Light Attack</span><kbd class="font-bold">LMB</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Heavy / Guardbreak</span><kbd class="font-bold">R / M2</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Block / Parry</span><kbd class="font-bold">F</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Dash / Dodge</span><kbd class="font-bold">Q</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Summon Stand</span><kbd class="font-bold">E</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>EX / Awakening Move</span><kbd class="font-bold">T</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Sprint</span><kbd class="font-bold">Left Shift / W+W</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Pilot Mode</span><kbd class="font-bold">Left Control</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Camera Shiftlock</span><kbd class="font-bold">Left Alt</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Pose (Charge Meter)</span><kbd class="font-bold">P</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>Crouch (Stealth)</span><kbd class="font-bold">C</kbd></div>
              <div class="p-3 bg-slate-50 rounded-lg flex justify-between font-mono"><span>In-Game Menu</span><kbd class="font-bold">M</kbd></div>
            </div>
          </section>

          <section id="mobile-layout" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Mobile Touch Controls &amp; Aim-Lock</h2>
            <p>
              On mobile devices, STAND OUT renders a specialized on-screen button grid. As of the October 28 patch, tapping the <strong>Lock-On crosshair icon</strong> automatically centers your camera on the nearest enemy player or boss, eliminating camera control drift during high-speed PvP.
            </p>
          </section>
        </>
      )}

      {guide.slug === 'level-up-fast' && (
        <>
          <section id="level-cap" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Level Cap &amp; Stat Point Breakdown</h2>
            <p>
              The maximum level cap in STAND OUT is <strong>Level 75</strong>. Each level grants 3 Stat Points, giving you a total of <strong>225 points</strong> to invest across Health, Damage, and Ability.
            </p>
          </section>

          <!-- Interactive Build Maker embedded directly into Leveling Guide -->
          <div class="my-8">
            <BuildMaker client:load />
          </div>

          <section id="early-levels" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Levels 1 - 25: Storyline Rush</h2>
            <p>
              Do not farm random town thugs during the early levels. Rush directly through Main Storyline Quests 1 to 5. Quests give guaranteed high chunks of EXP (e.g. 8,000 to 15,000 EXP per completion) and unlock essential utility items like the Smartphone.
            </p>
          </section>

          <section id="mid-levels" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Levels 26 - 50: Bounty Stacking</h2>
            <p>
              Use the Bounties application on your Phone to accept NPC bounty contracts. Stack 3 bounties that spawn in adjacent sectors (such as Highway or Shore) to clear multiple targets in a single circuit.
            </p>
          </section>

          <section id="endgame-grind" class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Levels 51 - 75: 77 Rings Raid Grinding</h2>
            <p>
              Once you hit Level 50, enter the <strong>77 Rings Raid</strong> with a party of 2-3 players. Wave clears in the graveyard grant exponential EXP multipliers and rare gear drops like Tarkus's Iron Helmet.
            </p>
          </section>
        </>
      )}

      {/* Default content template for remaining guides */}
      {guide.slug !== 'beginner-guide' && guide.slug !== 'controls' && guide.slug !== 'level-up-fast' && (
        <>
          <section class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-2xl font-black text-slate-900">Walkthrough &amp; Overview</h2>
            <p>
              Welcome to the specialized guide for <strong>{guide.title}</strong> in Roblox STAND OUT. This walkthrough is based on verified mechanics, frame data, and developer patch notes from Studio Umbra: Europa.
            </p>

            <div class="space-y-6 pt-4">
              {guide.tableOfContents.map((section, idx) => (
                <div id={section.id} class="p-4 bg-slate-50 rounded-xl border border-slate-100">
                  <h3 class="font-black text-base text-slate-900 mb-2">
                    {idx + 1}. {section.title}
                  </h3>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    Follow these step-by-step instructions to optimize your progress. Ensure your character meets the prerequisite level thresholds and has acquired appropriate gear pieces like DIO's Jacket or the Shadow Cloak before tackling high-difficulty encounters.
                  </p>
                </div>
              ))}
            </div>
          </section>
        </>
      )}
    </div>

    <!-- Related Guides Footer -->
    {relatedGuides.length > 0 && (
      <div class="mt-16 pt-8 border-t border-slate-200">
        <h2 class="text-sm font-black uppercase tracking-wider text-slate-500 mb-4">
          Related Guides in {guide.category}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedGuides.map((rel) => (
            <a
              href={`/guides/${rel.slug}/`}
              class="p-4 rounded-xl bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-xs transition-all block"
            >
              <h3 class="font-bold text-xs text-slate-900 line-clamp-2">{rel.title}</h3>
              <span class="text-[11px] text-emerald-700 font-semibold mt-2 block">Read Guide →</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

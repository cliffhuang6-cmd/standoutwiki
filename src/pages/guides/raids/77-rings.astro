---
import Layout from '../../../layouts/Layout.astro';

import AdLeaderboard from '../../../components/ads/AdLeaderboard.astro';
import AdNative from '../../../components/ads/AdNative.astro';
---

<Layout
  title="77 Rings Raid Guide – Walkthrough, Bosses & Pluck Drops | Stand Out Wiki"
  description="Master the 77 Rings Raid in Roblox STAND OUT. Complete wave walkthrough, boss attack mechanics, team requirements, and guaranteed Pluck fragment rewards."
  canonicalPath="guides/raids/77-rings"
  breadcrumbs={[
    { label: 'Guides', href: '/guides/' },
    { label: 'Raids', href: '/guides/raids/' },
    { label: '77 Rings Raid' }
  ]}
  schemaType="Article"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-bold mb-3 border border-rose-200">
        <span>Endgame Dungeon Raid</span>
        <span>•</span>
        <span>Honolulu Underground</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        77 Rings Raid Guide: Complete Walkthrough &amp; Drops
      </h1>

      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        The <strong>77 Rings Raid</strong> is one of the premier endgame PvE challenges in Roblox <strong>STAND OUT</strong>. Featuring multi-wave mob gauntlets, punishing boss mechanics, and the exclusive drop of <strong>Pluck sword fragments</strong> and <strong>Bizarre Arrows</strong>, conquering this raid is essential for mastering top-tier combat builds.
      </p>
    </div>

    <!-- Top Above-The-Fold Adsterra Responsive Leaderboard -->
    <AdLeaderboard className="mb-10" />

    <!-- Quick Overview Box -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl bg-white border border-slate-200 shadow-xs mb-10 text-xs">
      <div>
        <span class="text-slate-400 font-bold uppercase tracking-wider block">Recommended Level</span>
        <span class="text-slate-900 font-extrabold text-base mt-0.5 block">Level 35–50</span>
      </div>
      <div>
        <span class="text-slate-400 font-bold uppercase tracking-wider block">Team Size</span>
        <span class="text-slate-900 font-extrabold text-base mt-0.5 block">1–4 Players</span>
      </div>
      <div>
        <span class="text-slate-400 font-bold uppercase tracking-wider block">Key Reward</span>
        <span class="text-emerald-700 font-extrabold text-base mt-0.5 block">Pluck Parts</span>
      </div>
      <div>
        <span class="text-slate-400 font-bold uppercase tracking-wider block">Time Limit</span>
        <span class="text-slate-900 font-extrabold text-base mt-0.5 block">15 Minutes</span>
      </div>
    </div>

    <!-- How to Start -->
    <section class="mb-12 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-xs">
      <h2 class="text-2xl font-black text-slate-900 mb-4">How to Enter the 77 Rings Raid</h2>
      <p class="text-sm text-slate-600 leading-relaxed mb-4">
        To launch the 77 Rings raid, travel to the <strong>Canal District docks</strong> in southern Honolulu. Speak with the <strong>Raid Gatekeeper NPC</strong> stationed beside the reinforced bunker entrance. 
      </p>

      <div class="space-y-3 text-xs sm:text-sm">
        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
          <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-xs">1</span>
          <div>
            <strong class="text-slate-900">Form a Party (Optional but Recommended):</strong> While solo completion is possible at max Level 50 with high-sustain Stands like <em>Highway Star</em>, a coordinated duo or squad significantly reduces clear times.
          </div>
        </div>

        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
          <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-xs">2</span>
          <div>
            <strong class="text-slate-900">Raid Ticket / Level Gate:</strong> Verify all party members meet the minimum level prerequisite before the party leader initiates queue entry.
          </div>
        </div>

        <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
          <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center shrink-0 text-xs">3</span>
          <div>
            <strong class="text-slate-900">Dungeon Instance Boot:</strong> The party will be teleported into the subterranean circular arena known as the 77 Rings Chamber.
          </div>
        </div>
      </div>
    </section>

    <!-- Wave by Wave Breakdown -->
    <section class="mb-12 space-y-6">
      <h2 class="text-2xl font-black text-slate-900">77 Rings Wave Breakdown &amp; Boss Tactics</h2>

      <!-- Wave 1 & 2 -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-100 text-amber-800 text-xs font-bold mb-2">
          Wave 1 &amp; 2: Mob Clearance
        </div>
        <h3 class="text-lg font-bold text-slate-900">Passione Enforcers &amp; Hitmen</h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          Enemies spawn in clusters along the outer perimeter ring. Focus on grouping mobs together using wide sweeping attacks (such as Star Platinum's slam or Magician's Red firestorms). Keep moving around the outer edge to prevent ranged snipers from pinning down your guard.
        </p>
      </div>

      <!-- Wave 3 -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-purple-100 text-purple-800 text-xs font-bold mb-2">
          Wave 3: Sub-Boss
        </div>
        <h3 class="text-lg font-bold text-slate-900">Sub-Boss: Underground Trapper</h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          The sub-boss summons ground fissures and delayed blast zones. Watch for glowing red markers on the stone floor. Do not hold block continuously during his heavy windup—dash backward (Q) or execute a perfect parry (F) to break his posture and unleash full EX awakening combos.
        </p>
      </div>

      <!-- Wave 4 & 5 -->
      <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-rose-100 text-rose-800 text-xs font-bold mb-2">
          Wave 4 &amp; 5: Final Encounter
        </div>
        <h3 class="text-lg font-bold text-slate-900">The 77 Rings Champion</h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
          The final boss possesses super armor during normal light combos. Bait his three-hit flurry, evade behind him, and punish during his recovery frames. If running with a <em>Time Stop</em> Stand (Star Platinum: The World or The World), coordinate your awakening so teammates can land uninterruptible heavy hits during frozen time.
        </p>
      </div>
    </section>

    <!-- Rewards & Drops Table -->
    <section class="mb-12 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-xs">
      <h2 class="text-2xl font-black text-slate-900 mb-4">Confirmed 77 Rings Raid Rewards</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-slate-500 uppercase text-[11px] font-bold">
              <th class="pb-3">Reward Item</th>
              <th class="pb-3">Drop Probability</th>
              <th class="pb-3">Primary Use</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="py-3 font-bold text-slate-900">Pluck Fragment (Sword Part)</td>
              <td class="py-3 text-emerald-700 font-bold">Guaranteed (1–2x per clear)</td>
              <td class="py-3 text-slate-600">Assemble to forge the Pluck sword martial weapon</td>
            </tr>
            <tr>
              <td class="py-3 font-bold text-slate-900">Bizarre Arrow</td>
              <td class="py-3 text-purple-700 font-bold">Rare Bonus Drop (~10–15%)</td>
              <td class="py-3 text-slate-600">Roll for Pinnacle &amp; Mythical Stands with 4.4% pinnacle odds</td>
            </tr>
            <tr>
              <td class="py-3 font-bold text-slate-900">Dalas Currency</td>
              <td class="py-3 text-slate-700 font-bold">3,500 – 5,000 Dalas</td>
              <td class="py-3 text-slate-600">Bankroll Stand storage chips, seed purchases, and items</td>
            </tr>
            <tr>
              <td class="py-3 font-bold text-slate-900">EXP Payout</td>
              <td class="py-3 text-slate-700 font-bold">12,000+ EXP</td>
              <td class="py-3 text-slate-600">Fast progression toward the Level 50 cap</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mid-Page Adsterra Native Banner -->
    <AdNative className="my-10" />

    <!-- Cross-links -->
    <div class="p-6 rounded-2xl bg-emerald-50/70 border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-sm text-emerald-950">Looking to craft the Pluck sword with your drops?</h4>
        <p class="text-xs text-emerald-800/80 mt-0.5">Explore our dedicated Pluck sword walkthrough and Hamon combo synergies.</p>
      </div>
      <a
        href="/items/pluck/"
        class="px-4 py-2 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-800 transition-colors shrink-0"
      >
        View Pluck Guide →
      </a>
    </div>
  </div>
</Layout>

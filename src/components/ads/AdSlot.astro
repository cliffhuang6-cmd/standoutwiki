---
import { ADSTERRA_UNITS, isAdUnitActive, type AdUnitKey, type AdDeviceScope } from '../../data/ads';

interface Props {
  unit: AdUnitKey;
  pageType?: string;
  deviceOverride?: AdDeviceScope;
  theme?: 'light' | 'dark';
  label?: string;
  className?: string;
  sticky?: boolean;
}

const {
  unit,
  pageType,
  deviceOverride,
  theme = 'light',
  label,
  className = '',
  sticky = false,
} = Astro.props;

const active = isAdUnitActive(unit, pageType);
const cfg = ADSTERRA_UNITS[unit];
const deviceScope: AdDeviceScope = deviceOverride || cfg.device;
const slotLabel = label || (unit === 'native' ? 'Sponsored Content' : 'Advertisement');

const sizeBoxClassMap: Record<AdUnitKey, string> = {
  banner_728x90: 'w-[728px] min-h-[90px]',
  banner_468x60: 'w-[468px] min-h-[60px]',
  banner_320x50: 'w-[320px] min-h-[50px]',
  banner_160x300: 'w-[160px] min-h-[300px]',
  banner_300x250: 'w-[300px] min-h-[250px]',
  banner_160x600: 'w-[160px] min-h-[600px]',
  native: 'w-full min-h-[180px]',
};

const cardMaxWidthClassMap: Record<AdUnitKey, string> = {
  banner_728x90: 'max-w-[756px]',
  banner_468x60: 'max-w-[496px]',
  banner_320x50: 'max-w-[340px]',
  banner_160x300: 'w-[180px]',
  banner_300x250: 'w-[320px] max-w-full',
  banner_160x600: 'w-[180px]',
  native: 'w-full max-w-4xl',
};

const visibilityClass =
  deviceScope === 'desktop'
    ? unit === 'banner_468x60'
      ? 'hidden md:flex'
      : 'hidden lg:flex'
    : deviceScope === 'mobile'
      ? 'flex lg:hidden'
      : 'flex';
---

{active && (
  <Fragment>
    {deviceScope === 'desktop' && <Fragment set:html={'<!-- ADSTERRA_DEVICE:desktop:start -->'} />}
    {deviceScope === 'mobile' && <Fragment set:html={'<!-- ADSTERRA_DEVICE:mobile:start -->'} />}
    <aside
      class:list={[
        'adsterra-slot flex-col items-center justify-center',
        visibilityClass,
        sticky && 'lg:sticky lg:top-20',
        className,
      ]}
      data-adsterra-unit={unit}
      data-adsterra-id={cfg.placementId}
      aria-label={slotLabel}
    >
      <div
        class:list={[
          'mx-auto rounded-2xl border p-2 sm:p-2.5 flex flex-col items-center justify-center shadow-xs overflow-hidden',
          cardMaxWidthClassMap[unit],
          theme === 'dark'
            ? 'bg-slate-900/90 border-emerald-500/30 text-emerald-300'
            : 'bg-white/95 border-slate-200/90 text-slate-700',
        ]}
      >
        <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5 flex items-center justify-between w-full px-1 opacity-70">
          <span>{slotLabel}</span>
          <span class="text-[9px] font-normal opacity-60">Ad</span>
        </div>
        <div class:list={['flex items-center justify-center overflow-hidden', sizeBoxClassMap[unit]]}>
          <Fragment set:html={cfg.rawHtml} />
        </div>
      </div>
    </aside>
    {deviceScope === 'desktop' && <Fragment set:html={'<!-- ADSTERRA_DEVICE:desktop:end -->'} />}
    {deviceScope === 'mobile' && <Fragment set:html={'<!-- ADSTERRA_DEVICE:mobile:end -->'} />}
  </Fragment>
)}

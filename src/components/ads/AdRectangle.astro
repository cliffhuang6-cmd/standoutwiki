---
// src/components/ads/AdRectangle.astro
// Adsterra 300x250 Medium Rectangle (MPU)
// Key: 1cd15e0c9cd4615eb2f2bb7e822a10bc
// Clean dynamic script injection to ensure valid domain Referer.

interface Props {
  className?: string;
  theme?: 'light' | 'dark';
}

const { className = '', theme = 'light' } = Astro.props;
const slotId = 'ad-rect-' + Math.random().toString(36).substring(2, 9);
const adKey = '1cd15e0c9cd4615eb2f2bb7e822a10bc';
---

<aside class:list={['adsterra-rectangle-slot flex flex-col items-center justify-center my-4', className]} aria-label="Advertisement">
  <div class:list={[
    'adsterra-card rounded-2xl border p-2.5 flex flex-col items-center justify-center shadow-xs transition-all w-[320px] max-w-full overflow-hidden',
    theme === 'dark'
      ? 'bg-slate-900/90 border-emerald-500/30 text-emerald-300'
      : 'bg-white/90 border-slate-200/90 text-slate-700'
  ]}>
    <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5 flex items-center justify-between w-full px-1 opacity-70">
      <span>Advertisement</span>
      <span class="text-[9px] font-normal opacity-60">Sponsored</span>
    </div>

    <!-- 300x250 Adsterra Banner Container -->
    <div
      id={slotId}
      class="flex items-center justify-center overflow-hidden min-h-[250px] w-[300px]"
    >
    </div>
  </div>
</aside>

<script is:inline define:vars={{ slotId, adKey }}>
  (function() {
    var container = document.getElementById(slotId);
    if (!container) return;

    window.atOptions = {
      'key' : adKey,
      'format' : 'iframe',
      'height' : 250,
      'width' : 300,
      'params' : {}
    };

    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.setAttribute('data-cfasync', 'false');
    s.src = 'https://bauval.org/22/' + adKey;
    container.appendChild(s);
  })();
</script>

---
// src/components/ads/AdNative.astro
// Adsterra Native Banner Unit
// Key/Container: container-5acaf1a7c60cb8bca924bc58e632bc21
// IMPORTANT: This container ID must appear AT MOST ONCE per page to prevent duplicate ID issues.

interface Props {
  className?: string;
  theme?: 'light' | 'dark';
}

const { className = '', theme = 'light' } = Astro.props;
---

<aside class:list={['adsterra-native-slot w-full flex flex-col items-center justify-center my-8', className]} aria-label="Sponsored Content">
  <div class:list={[
    'adsterra-card w-full max-w-4xl mx-auto rounded-2xl border p-3 sm:p-4 shadow-xs transition-all overflow-hidden',
    theme === 'dark'
      ? 'bg-slate-900/90 border-emerald-500/30 text-emerald-300'
      : 'bg-white/90 border-slate-200/90 text-slate-700'
  ]}>
    <div class="text-[10px] font-bold uppercase tracking-wider mb-2 flex items-center justify-between w-full px-1 opacity-70">
      <span>Sponsored Content</span>
      <span class="text-[9px] font-normal opacity-60">Advertisement</span>
    </div>

    <!-- Adsterra Native Banner Integration -->
    <div class="w-full overflow-hidden flex justify-center min-h-[160px]">
      <script async="async" data-cfasync="false" src="https://bauval.org/21/5acaf1a7c60cb8bca924bc58e632bc21"></script>
      <div id="container-5acaf1a7c60cb8bca924bc58e632bc21" class="w-full"></div>
    </div>
  </div>
</aside>

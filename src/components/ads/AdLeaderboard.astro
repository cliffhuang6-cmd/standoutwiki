---
// src/components/ads/AdLeaderboard.astro
// Responsive Adsterra Leaderboard:
// Desktop (>= 768px): 728x90 (Key: 946300eccbdefccddb6696a256bc33df)
// Mobile (< 768px): 320x50 (Key: d815193dc48ce20f8fb5e56c6642e7ea)
// Clean dynamic script injection to ensure valid domain Referer and zero duplicate requests.

interface Props {
  className?: string;
  theme?: 'light' | 'dark';
}

const { className = '', theme = 'light' } = Astro.props;
const slotId = 'ad-lead-' + Math.random().toString(36).substring(2, 9);
---

<aside class:list={['adsterra-leaderboard-slot w-full flex flex-col items-center justify-center my-6', className]} aria-label="Advertisement">
  <div class:list={[
    'adsterra-card w-full max-w-[760px] mx-auto rounded-2xl border p-2 sm:p-3 flex flex-col items-center justify-center shadow-xs transition-all overflow-hidden',
    theme === 'dark'
      ? 'bg-slate-900/90 border-emerald-500/30 text-emerald-300'
      : 'bg-white/90 border-slate-200/90 text-slate-700'
  ]}>
    <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5 flex items-center justify-between w-full max-w-[728px] px-1 opacity-70">
      <span>Advertisement</span>
      <span class="text-[9px] font-normal opacity-60">Sponsored</span>
    </div>

    <!-- Responsive Adsterra Banner Container -->
    <div
      id={slotId}
      class="flex items-center justify-center overflow-hidden min-h-[50px] md:min-h-[90px] w-full max-w-[728px]"
    >
    </div>
  </div>
</aside>

<script is:inline define:vars={{ slotId }}>
  (function() {
    var container = document.getElementById(slotId);
    if (!container) return;

    var isDesktop = window.innerWidth >= 768;
    var adKey = isDesktop ? '946300eccbdefccddb6696a256bc33df' : 'd815193dc48ce20f8fb5e56c6642e7ea';
    var adWidth = isDesktop ? 728 : 320;
    var adHeight = isDesktop ? 90 : 50;

    window.atOptions = {
      'key' : adKey,
      'format' : 'iframe',
      'height' : adHeight,
      'width' : adWidth,
      'params' : {}
    };

    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.setAttribute('data-cfasync', 'false');
    s.src = 'https://bauval.org/22/' + adKey;
    container.appendChild(s);
  })();
</script>

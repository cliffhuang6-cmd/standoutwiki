---
// src/components/ads/AdLeaderboard.astro
// Responsive Adsterra Leaderboard:
// Desktop (>= 1024px): 728x90 (Key: 946300eccbdefccddb6696a256bc33df)
// Tablet (640px - 1023px): 468x60 (Key: 61151bb6310811643867c8c0acc4d593)
// Mobile (< 640px): 320x50 (Key: d815193dc48ce20f8fb5e56c6642e7ea)
// Isolated in friendly iframe to prevent global atOptions collision and dual requests.

interface Props {
  className?: string;
  theme?: 'light' | 'dark';
}

const { className = '', theme = 'light' } = Astro.props;
const slotId = 'ad-lead-' + Math.random().toString(36).substring(2, 9);
---

<aside class:list={['adsterra-leaderboard-slot w-full flex flex-col items-center justify-center my-6', className]} aria-label="Advertisement">
  <div class:list={[
    'adsterra-card w-full max-w-[760px] mx-auto rounded-2xl border p-2 sm:p-3 flex flex-col items-center justify-center shadow-xs transition-all overflow-hidden',
    theme === 'dark'
      ? 'bg-slate-900/90 border-emerald-500/30 text-emerald-300'
      : 'bg-white/90 border-slate-200/90 text-slate-700'
  ]}>
    <div class="text-[10px] font-bold uppercase tracking-wider mb-1.5 flex items-center justify-between w-full max-w-[728px] px-1 opacity-70">
      <span>Advertisement</span>
      <span class="text-[9px] font-normal opacity-60">Sponsored</span>
    </div>

    <!-- Responsive Adsterra Banner Container -->
    <div
      id={slotId}
      class="flex items-center justify-center overflow-hidden min-h-[50px] sm:min-h-[60px] lg:min-h-[90px] w-full max-w-[728px]"
    >
    </div>
  </div>
</aside>

<script is:inline define:vars={{ slotId }}>
  (function() {
    var container = document.getElementById(slotId);
    if (!container) return;

    var width = window.innerWidth;
    var adWidth, adHeight, adKey;

    if (width >= 1024) {
      // Desktop: 728x90
      adWidth = '728';
      adHeight = '90';
      adKey = '946300eccbdefccddb6696a256bc33df';
    } else if (width >= 640) {
      // Tablet: 468x60
      adWidth = '468';
      adHeight = '60';
      adKey = '61151bb6310811643867c8c0acc4d593';
    } else {
      // Mobile: 320x50
      adWidth = '320';
      adHeight = '50';
      adKey = 'd815193dc48ce20f8fb5e56c6642e7ea';
    }

    var iframe = document.createElement('iframe');
    iframe.style.border = 'none';
    iframe.style.overflow = 'hidden';
    iframe.scrolling = 'no';
    iframe.setAttribute('title', 'Advertisement');
    iframe.width = adWidth;
    iframe.height = adHeight;

    var iframeHtml = '<!DOCTYPE html><html><head><meta charset="utf-8">' +
      '<style>body{margin:0;padding:0;overflow:hidden;background:transparent;display:flex;justify-content:center;align-items:center;}</style>' +
      '</head><body>' +
      '<scr' + 'ipt type="text/javascript" data-cfasync="false">' +
      'atOptions = {' +
      "  'key' : '" + adKey + "'," +
      "  'format' : 'iframe'," +
      "  'height' : " + adHeight + "," +
      "  'width' : " + adWidth + "," +
      "  'params' : {}" +
      '};' +
      '</scr' + 'ipt>' +
      '<scr' + 'ipt type="text/javascript" data-cfasync="false" src="https://bauval.org/22/' + adKey + '"></scr' + 'ipt>' +
      '</body></html>';

    iframe.srcdoc = iframeHtml;
    container.appendChild(iframe);
  })();
</script>

---
// src/components/AdsterraBanner.astro
// Reusable Adsterra Native Banner component for Stand Out Wiki
interface Props {
  theme?: 'light' | 'dark';
  className?: string;
}

const { theme = 'light', className = '' } = Astro.props;
---

<aside class={`adsterra-banner-wrapper w-full ${className}`} aria-label="Sponsored Content">
  <div class={`adsterra-banner-container overflow-hidden rounded-2xl border p-4 sm:p-5 shadow-xs ${
    theme === 'dark' 
      ? 'bg-slate-900/80 border-emerald-500/30 text-emerald-300' 
      : 'bg-white/80 border-slate-200/90 text-slate-700'
  }`}>
    <div class="text-[11px] font-bold uppercase tracking-wider mb-2 flex items-center justify-between opacity-80">
      <span>Sponsored Content</span>
      <span class="text-[10px] font-normal opacity-70">Advertisement</span>
    </div>
    <div class="min-h-[160px] flex items-center justify-center w-full">
      <script is:inline async="async" data-cfasync="false" src="https://bauval.org/21/5acaf1a7c60cb8bca924bc58e632bc21"></script>
      <div id="container-5acaf1a7c60cb8bca924bc58e632bc21" class="w-full"></div>
    </div>
  </div>
</aside>

---
import type { Stand } from '../types';

interface Props {
  stand: Stand;
}

const { stand } = Astro.props;

const rarityBadgeClasses: Record<string, string> = {
  Pinnacle: 'bg-rose-100 text-rose-800 border-rose-200',
  Exclusive: 'bg-violet-100 text-violet-900 border-violet-200',
  Historical: 'bg-slate-200 text-slate-800 border-slate-300',
  Mythical: 'bg-amber-100 text-amber-900 border-amber-200',
  Legendary: 'bg-purple-100 text-purple-900 border-purple-200',
  Epic: 'bg-sky-100 text-sky-900 border-sky-200',
  Rare: 'bg-emerald-100 text-emerald-900 border-emerald-200',
  Evolution: 'bg-teal-100 text-teal-900 border-teal-200',
  'Alternative Universe': 'bg-indigo-100 text-indigo-900 border-indigo-200',
  Quest: 'bg-blue-100 text-blue-900 border-blue-200',
};
---

<a
  href={`/stands/${stand.slug}/`}
  class="bg-white rounded-2xl border border-slate-200 p-4 hover:border-emerald-500 hover:shadow-lg transition-all duration-200 group flex flex-col justify-between"
>
  <div>
    <!-- Stand Image Container -->
    <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-slate-100 mb-3 border border-slate-100">
      <img
        src={`${stand.image}?v=2`}
        alt={`${stand.name} Stand in Roblox STAND OUT`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
      />
      <!-- Rarity Chip Top Right -->
      <span
        class={`absolute top-2 right-2 px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded-md border shadow-xs ${
          rarityBadgeClasses[stand.rarity] || 'bg-slate-100 text-slate-800'
        }`}
      >
        {stand.rarity}
      </span>
      <!-- PvP Tier Rank Top Left -->
      <span class="absolute top-2 left-2 px-2 py-0.5 text-[11px] font-mono font-black rounded-md bg-slate-900/80 text-white backdrop-blur-xs border border-white/10">
        PvP {stand.tier.pvp}
      </span>
    </div>

    <!-- Stand Name & Canon User -->
    <h3 class="font-black text-base text-slate-900 group-hover:text-emerald-700 transition-colors">
      {stand.name}
    </h3>
    <p class="text-xs font-semibold text-slate-500 mt-0.5">
      User: {stand.canonicalUser}
    </p>
    <p class="text-[11px] text-slate-400 mt-0.5">
      {stand.jojoPart}
    </p>

    <!-- Short Lore snippet -->
    <p class="text-xs text-slate-600 line-clamp-2 mt-2 leading-relaxed">
      {stand.lore}
    </p>
  </div>

  <!-- Bottom Badges / Role -->
  <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-xs">
    <span class="font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">
      {stand.combatRole}
    </span>
    <span class="text-slate-400 group-hover:text-emerald-600 font-bold flex items-center gap-1 transition-colors text-[11px]">
      View Moveset →
    </span>
  </div>
</a>
